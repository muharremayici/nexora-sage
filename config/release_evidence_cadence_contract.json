      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "scope",
        "artifact"
      ],
      "rule": "Perform human claim review only when a public capability or claim boundary changes; unchanged patch releases retain the active claim profile."
    },
    {
      "id": "license_review",
      "subject": "license_review",
      "cadence": "change_triggered",
      "owner_id": "claim_and_license_authority",
      "required_phases": [],
      "run_triggers": [
        "license_strategy_changed"
      ],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "scope",
        "artifact"
      ],
      "rule": "Perform human license review only for an explicit future unpublished-release strategy change. Published grants remain immutable; version increments alone do not reopen license strategy."
    }
