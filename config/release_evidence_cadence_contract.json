      "owner_id": "existing_private_release_controller",
      "required_phases": [
        "publication"
      ],
      "run_triggers": [
        "publication_requested"
      ],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "scope",
        "artifact",
        "controller"
      ],
      "rule": "Require one explicit human publication statement bound to exact source, clean and public identities. No validation result can synthesize it."
    },
    {
      "id": "react_corpus_replay",
      "subject": "react_corpus_replay",
      "cadence": "change_triggered",
      "owner_id": "external_repository_evaluation",
      "required_phases": [],
      "run_triggers": [
        "analysis_semantics_changed",
        "corpus_contract_changed",
        "external_evidence_gap_observed",
        "explicit_corpus_evaluation_selected"
