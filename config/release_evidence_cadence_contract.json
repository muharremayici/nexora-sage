      ],
      "run_triggers": [],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "artifact",
        "controller"
      ],
      "rule": "Prove candidate and staged public bytes once during exact candidate preparation, then consume the content-bound receipt at freeze. The cadence decision does not transport, commit, tag or publish them."
    },
    {
      "id": "projected_public_affected_tests",
