{
  "meta": {
    "kind": "nexora.release_evidence_cadence_contract",
    "version": "1.1.0",
    "status": "normative",
    "purpose": "Select the minimum dependency-correct release evidence cadence without weakening exact-byte, human-authority, fail-closed or final-candidate boundaries."
