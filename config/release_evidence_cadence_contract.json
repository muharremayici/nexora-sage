      ],
      "run_triggers": [],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "artifact",
        "controller"
      ],
      "rule": "Prove clean-delivery bytes once during exact candidate preparation, then consume the content-bound receipt at freeze; never rebuild an unchanged projection or reuse another candidate's manifest or a version label."
    },
    {
      "id": "public_projection_byte_identity",
      "subject": "public_projection_bytes",
      "cadence": "always_fresh",
      "owner_id": "existing_private_release_controller",
      "required_phases": [
