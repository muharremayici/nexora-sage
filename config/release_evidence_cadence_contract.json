      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "environment",
        "scope"
      ],
      "rule": "Run the fast reference-runtime gate on pull requests and source-bearing updates."
    },
    {
      "id": "ci_release_deep",
      "subject": "ci_release_deep",
      "cadence": "final_candidate_aggregate",
      "aggregate_strategy": "fresh_execution",
      "owner_id": "github_quality_gate",
      "required_phases": [
        "frozen_candidate"
      ],
      "run_triggers": [],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "environment",
        "scope",
        "artifact"
      ],
      "rule": "Run the release-deep matrix once for the exact candidate rather than multiplying the full suite across every development push."
    },
    {
      "id": "ci_periodic_compatibility",
      "subject": "ci_periodic_compatibility",
      "cadence": "periodic",
      "owner_id": "github_quality_gate",
      "required_phases": [],
      "run_triggers": [
        "periodic_compatibility_due"
      ],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "environment",
        "scope"
      ],
      "rule": "Run supported-runtime and platform compatibility on its declared schedule and on release-deep boundaries, not by duplicating every pull-request suite."
    },
    {
      "id": "human_doctrine_seal",
      "subject": "human_doctrine_seal",
      "cadence": "change_triggered",
      "owner_id": "human_seal_authority",
      "required_phases": [],
      "run_triggers": [
        "protected_doctrine_changed",
        "agent_surface_semantics_changed",
        "claim_boundary_changed",
        "license_strategy_changed"
      ],
