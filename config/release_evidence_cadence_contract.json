        "policy",
        "runtime",
        "scope",
        "artifact"
      ],
      "rule": "Run the affected public-applicable shard during iteration so packaging defects fail before the clean commit."
    },
    {
      "id": "projected_public_test_aggregate",
      "subject": "projected_public_tests",
      "cadence": "final_candidate_aggregate",
      "aggregate_strategy": "fresh_execution",
      "owner_id": "distribution_test_profiles",
      "required_phases": [
        "frozen_candidate"
      ],
      "run_triggers": [],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "scope",
        "artifact"
      ],
      "rule": "Aggregate the exact contract-owned public test union once for the frozen projected package."
    },
    {
      "id": "independent_physical_install",
      "subject": "independent_physical_install",
      "cadence": "baseline_plus_delta",
      "owner_id": "installation_evidence",
      "required_phases": [
        "frozen_candidate"
      ],
      "run_triggers": [
        "version_identity_changed",
        "installer_semantics_changed",
        "bootstrap_semantics_changed",
        "dependency_semantics_changed",
        "runtime_support_changed",
        "os_support_changed",
        "environment_specific_failure_observed"
      ],
      "fresh_retest_triggers": [
        "installer_semantics_changed",
        "bootstrap_semantics_changed",
        "dependency_semantics_changed",
        "runtime_support_changed",
        "os_support_changed",
        "environment_specific_failure_observed"
      ],
      "baseline_required": true,
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "environment",
        "scope",
        "artifact"
      ],
      "rule": "A version-only release uses an accepted independent baseline plus current isolated delta. A protected installation semantic change, OS/runtime expansion or environment-specific failure requires a fresh independent environment."
    },
    {
      "id": "isolated_installation_smoke",
      "subject": "isolated_install",
      "cadence": "always_fresh",
      "owner_id": "installation_evidence",
      "required_phases": [
        "frozen_candidate"
      ],
      "run_triggers": [],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "environment",
        "artifact"
      ],
      "rule": "Compatibility id retained for the frozen-candidate fresh boundary. The current producer is a same-checkout doctor/MCP/validator smoke, not a temporary-package or isolated-venv installation, and must not be claimed as independent isolation. A future producer upgrade requires its own verified receipt semantics; this row never replaces conditional physical-machine proof."
    },
    {
      "id": "ci_pull_request_fast",
      "subject": "ci_pull_request_fast",
      "cadence": "change_triggered",
      "owner_id": "github_quality_gate",
      "required_phases": [],
