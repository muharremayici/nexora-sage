        "frozen_candidate"
      ],
      "run_triggers": [
        "release_proof_dependency_changed"
      ],
      "identity_dimensions": [
        "source",
        "configuration",
        "policy",
        "runtime",
        "environment",
        "scope",
        "artifact"
      ],
      "rule": "Run one complete aggregate for the exact frozen candidate. Development repairs use dependency-correct focused evidence; a changed proof dependency invalidates the next aggregate but does not force a full development-loop replay."
    },
    {
      "id": "clean_projection_byte_identity",
      "subject": "clean_projection_bytes",
      "cadence": "always_fresh",
      "owner_id": "existing_private_release_controller",
      "required_phases": [
