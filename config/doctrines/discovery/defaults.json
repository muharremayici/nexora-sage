{
  "_meta": {
    "kind": "nexora.doctrine_pack",
    "version": "1.0",
    "source": "config/architecture_doctrine.json",
    "namespace": "discovery.defaults",
    "merge_strategy": "deep_merge_top_level"
  },
  "discovery_host_intelligence_defaults": {
    "host_locked_patterns": [
      "**/api/index.*",
      "**/api/ports.*",
      "**/ports.*"
    ],
    "compose_preferred_patterns": [
      "**/application/**/*",
      "**/services/**/*",
      "**/entities/**/*Store*",
      "**/shared/hooks/**/*",
      "**/widgets/**/*"
    ],
    "manual_review_patterns": [
      "**/pages/**/*",
      "**/features/**/*",
      "**/widgets/**/*",
      "**/components/**/*"
    ],
    "public_boundary_patterns": [
      "**/api/index.*",
      "**/exports.*",
      "**/index.*"
    ],
    "integration_seam_patterns": [
      "**/Dispatcher*",
      "**/eventBus.*",
      "**/Pipeline*"
    ]
  },
  "discovery_project_role_markers": {
    "host_aliases": [
      "MAIN",
      "HOST",
      "CORE",
      "BASE"
    ],
    "variant_containers": [
      "variations",
      "variation",
      "variants",
      "forks",
      "donors"
    ],
    "variant_leaf_tokens": [
      "legacy",
      "fork",
      "variant"
    ],
    "companion_containers": [
      "apps",
      "packages",
      "modules",
      "extensions",
      "extension",
      "plugins",
      "plugin",
      "browser",
      "examples"
    ],
    "companion_path_tokens": [
      "lifecycle-modules"
    ]
  },
  "discovery_project_system_kind_policy": {
    "contract": "technical_system_kind_static_inventory_v1",
    "allowed_kinds": [
      "application",
      "library",
      "service",
      "tool",
      "configuration",
      "documentation",
      "asset_bundle",
      "unknown"
    ],
    "confidence_precedence": [
      "high",
      "medium",
      "low"
    ],
    "kind_precedence": [
      "documentation",
      "configuration",
      "asset_bundle",
      "tool",
      "service",
      "application",
      "library"
    ],
    "same_confidence_conflict_policy": "unknown",
    "manifest_dependency_sections": [
      "dependencies",
      "devDependencies",
      "peerDependencies",
      "optionalDependencies"
    ],
    "documentation_extensions": [
      ".md",
      ".mdx",
      ".rst",
      ".adoc"
    ],
    "configuration_extensions": [
      ".json",
      ".jsonc",
      ".yaml",
      ".yml",
      ".toml",
      ".ini",
      ".properties"
    ],
    "asset_extensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".svg",
      ".webp",
      ".ico",
      ".woff",
      ".woff2",
      ".ttf",
      ".otf"
    ],
    "documentation_dependency_markers": [
      "@docusaurus/core",
      "mintlify",
      "nextra",
      "vitepress"
    ],
    "documentation_script_tokens": [
      "docusaurus",
      "mintlify",
      "nextra",
      "vitepress"
    ],
    "application_dependency_markers": [
      "next",
      "react-scripts",
      "@remix-run/react",
      "@tanstack/react-start",
      "expo",
      "vite"
    ],
    "service_dependency_markers": [
      "@nestjs/core",
      "express",
      "fastify",
      "h3",
      "hono",
      "koa"
    ],
    "application_dependency_sections": [
      "dependencies",
      "devDependencies"
    ],
    "service_dependency_sections": [
      "dependencies",
      "optionalDependencies"
    ],
    "application_script_names": [
      "dev",
      "start"
    ],
    "tool_manifest_fields": [
      "bin"
    ],
    "library_manifest_fields": [
      "exports",
      "main",
      "module",
      "types",
      "typings"
    ],
    "dominance_threshold": 0.6,
    "minimum_dominant_file_count": 1
  }
}
