{
  "meta": {
    "kind": "nexora.installation_preflight_contract",
    "version": "v2",
    "purpose": "Target-aware, non-mutating machine readiness, dependency-installation planning and authority-scoped installation validation."
  },
  "profile": {
    "id": "human_and_ai_full",
    "default": true,
    "description": "Install the human CLI, live Watchdog and AI-facing MCP runtime together; target language evidence controls only language-toolchain requirements."
  },
  "validation_profiles": {
    "selection": {
      "public_target_repository": "PUBLIC_DISTRIBUTION_MANIFEST.json is present at the installation root.",
      "private_maintainer": "No public distribution manifest is present at the canonical source root."
    },
    "public_target_repository": {
      "purpose": "Validate only installation and target-repository surfaces shipped in the public projection.",
      "omit_checks": [
        "clean_mirror_sync_is_declared",
        "clean_mirror_closeout_is_declared",
        "clean_mirror_excludes_workspace_truth_and_secrets",
        "release_proof_runs_installation_smoke"
      ],
      "installation_proof_omit_steps": [
        "final_consistency"
      ],
      "claim_boundary": "A public installation PASS does not validate private projection machinery, SAGE self-release governance or the target repository's engineering verdict."
    },
    "private_maintainer": {
      "purpose": "Validate public installation surfaces plus private projection and SAGE release-maintainer controls.",
      "omit_checks": [],
      "installation_proof_omit_steps": []
    }
  },
  "python": {
    "requirement_source": "pyproject.toml#project.requires-python",
    "tested_versions_source": "pyproject.toml#tool.nexora_sage.distribution.tested_python_versions",
    "package_install_command": [
      "{python}",
      "-m",
      "pip",
      "install",
      "-e",
      "{sage_root}"
    ],
    "system_runtime_install_policy": "never_automatic"
  },
  "python_features": {
    "mcp-runtime": {
      "module": "mcp.server.fastmcp",
      "attribute": "FastMCP",
      "package": "mcp",
      "required_by_default_profile": true,
      "runtime_compatibility": {
        "contract": "mcp_v1_fastmcp_settings_lifespan_v1",
        "dependency_specifier_source": "pyproject.toml#project.dependencies:mcp",
        "settings_model": "mcp.server.fastmcp.server.Settings",
        "preconstruction_public_hook": "model_rebuild",
        "required_order": [
          "fastmcp_module_imported",
          "settings_model_rebuilt",
          "profiled_server_constructed",
          "transport_started"
        ],
        "warning_suppression_allowed": false,
        "claim_boundary": "Completing the MCP v1 FastMCP Settings model prevents the known unresolved lifespan forward-reference warning. It does not suppress stderr, widen the supported major range, adopt MCP v2 or prove every future MCP/Pydantic combination."
      }
    },
    "watch-live": {
      "module": "watchdog.events",
      "attribute": "FileSystemEventHandler",
      "package": "watchdog",
      "required_by_default_profile": true
    },
    "terminal-ui": {
      "module": "rich",
      "attribute": null,
      "package": "rich",
      "required_by_default_profile": true
    },
    "json-repair": {
      "module": "json_repair",
      "attribute": null,
      "package": "json-repair",
      "required_by_default_profile": true
    }
  },
  "node": {
    "required_for_languages": [
      "javascript",
      "typescript"
    ],
    "required_when_react_signal": true,
    "release_reference_major": 20,
    "system_runtime_install_policy": "never_automatic",
    "bundled_typescript_marker": "tools/engines/node_modules/typescript/package.json",
    "package_manifest": "tools/engines/package.json",
    "package_install_command": [
      "{npm}",
      "ci",
      "--ignore-scripts"
    ]
  },
  "dependency_acquisition": {
    "contract": "capability_scoped_sage_runtime_acquisition_v1",
    "target_repository_threat_boundary": "config/target_repository_threat_boundary_contract.json",
    "budget_profile_source": "config/pipeline_execution_policy.json#dependency_acquisition_budgets",
    "authorities": {
      "sage_runtime": {
        "automatic_on_init": true,
        "target_repository_mutation": false
      },
      "target_native_validation": {
        "automatic_on_init": false,
        "mode": "manifest_and_source_observation_only",
        "target_repository_mutation": false
      }
    },
    "action_profiles": {
      "install_sage_python_dependencies": {
        "dependency_authority": "sage_runtime",
        "operation_class": "network_package_acquisition",
        "telemetry_identifier": "dependency install_sage_python_dependencies completed",
        "capability_source": "python_features.required_by_default_profile",
        "progress_relative_paths": [],
        "stall_authority_sources": []
      },
      "install_sage_node_ast_dependencies": {
        "dependency_authority": "sage_runtime",
        "operation_class": "network_package_acquisition",
        "telemetry_identifier": "dependency install_sage_node_ast_dependencies completed",
        "capability_source": "node.required_for_languages_or_react_signal",
        "progress_relative_paths": [
          "node_modules"
        ],
        "stall_authority_sources": [
          "filesystem"
        ]
      }
    },
    "cache_reuse": {
      "node_ast": "package_manifest_plus_lockfile_identity_and_installed_typescript_version",
      "claim_boundary": "A verified cache proves the declared manifest/lock identity and installed TypeScript package version. It does not hash every installed file or prove future command execution."
    },
    "outcome_classes": [
      "SUCCESS",
      "OFFLINE",
      "MISSING_MANAGER",
      "STALLED",
      "TIMED_OUT",
      "INSTALL_FAILED"
    ],
    "claim_boundary": "Automatic acquisition is limited to selected SAGE runtime capabilities. Target-native package installation, binaries, hooks and lifecycle scripts remain forbidden in automatic analysis and require a separate future execution authority that V1 does not provide."
  },
  "git": {
    "role": "source_acquisition_only",
    "required_after_source_and_target_are_present": false,
    "system_runtime_install_policy": "never_automatic"
  },
  "embedded_host_footprint": {
    "contract": "embedded_sage_host_footprint_v1",
    "applicability_by_installation_mode": {
      "self_target": "not_applicable_sage_self_analysis",
      "embedded": "operator_review_required",
      "central_external": "not_applicable_installation_outside_target"
    },
    "single_root_exclusion": true,
    "target_configuration_mutation_allowed": false,
    "pattern_templates": {
      "directory": "{embedded_root}/",
      "recursive_glob": "{embedded_root}/**"
    },
    "runtime_surfaces": [
      {
        "id": "source",
        "kind": "source",
        "relative_paths": [
          "."
        ]
      },
      {
        "id": "cache",
        "kind": "cache",
        "relative_paths": [
          ".mypy_cache",
          ".pytest_cache",
          ".ruff_cache",
          "tools/engines/node_modules"
        ],
        "recursive_names": [
          "__pycache__",
          "*.egg-info"
        ]
      },
      {
        "id": "database",
        "kind": "database",
        "relative_paths": [
          "codemaps.db",
          "nexora_kernel.db",
          "output/.raw/codemaps.db"
        ]
      },
      {
        "id": "log",
        "kind": "log",
        "relative_paths": [
          "output/logs"
        ]
      },
      {
        "id": "output",
        "kind": "output",
        "relative_paths": [
          "output",
          "reports",
          "scratch",
          "tenants"
        ]
      }
    ],
    "host_tools": {
      "eslint": {
        "surface": "lint",
        "configuration_surfaces": [
          "flat_config_ignores",
          "legacy_ignore_file"
        ]
      },
      "biome": {
        "surface": "lint_and_formatter",
        "configuration_surfaces": [
          "files_ignore_or_negative_include"
        ]
      },
      "stylelint": {
        "surface": "lint",
        "configuration_surfaces": [
          "ignore_files_or_ignore_pattern"
        ]
      },
      "prettier": {
        "surface": "formatter",
        "configuration_surfaces": [
          "prettierignore"
        ]
      },
      "typescript": {
        "surface": "compiler",
        "configuration_surfaces": [
          "tsconfig_exclude_or_bounded_include"
        ]
      },
      "vitest": {
        "surface": "test",
        "configuration_surfaces": [
          "test_exclude"
        ]
      },
      "jest": {
        "surface": "test",
        "configuration_surfaces": [
          "test_path_or_module_path_ignore_patterns"
        ]
      }
    },
    "baseline_surfaces": {
      "search": {
        "surface": "search",
        "configuration_surfaces": [
          "tool_native_exclude_or_bounded_search_root"
        ]
      },
      "packaging": {
        "surface": "packaging",
        "configuration_surfaces": [
          "tool_native_package_file_selection_or_ignore"
        ]
      }
    },
    "traversal_probe": {
      "probe_existing_declared_paths": true,
      "permission_mutation_allowed": false
    },
    "claim_boundary": "The footprint projection identifies one embedded SAGE root and emits non-mutating operator guidance. It does not prove that a host tool consumed the guidance, infer effective executable configuration, rewrite target-owned files or grant permission to change filesystem ACLs."
  },
  "status_policy": {
    "ready": "READY",
    "install_actions_available": "READY_WITH_INSTALL_ACTIONS",
    "attention": "ATTENTION",
    "blocked": "BLOCKED"
  },
  "mutation_policy": {
    "plan_is_read_only": true,
    "python_package_install_requires_init_without_skip_deps": true,
    "node_package_install_requires_init_without_skip_deps": true,
    "system_runtime_install_requires_explicit_external_action": true,
    "target_repository_mutation_allowed": false
  },
  "claim_boundary": "The plan observes one machine and one target snapshot. It may authorize declared SAGE-local package installation, but it never installs system runtimes, mutates the target repository, proves full analysis correctness or replaces clean-machine installation proof."
}
