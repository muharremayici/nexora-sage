        "content": "\nimport React, { lazy } from 'react';\nconst LazyPanel = lazy(() => import('./Panel'));\nexport function RuntimeEdges() {\n  if (featureFlags.newDashboard) return <LazyPanel />;\n  return <section>{Date.now()}</section>;\n}\n",
