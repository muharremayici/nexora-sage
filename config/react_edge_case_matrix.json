        "file": "app/api/books/route.ts",
        "content": "\nimport { NextRequest } from 'next/server';\nexport const revalidate = 60;\nexport async function POST(request: NextRequest) {\n  const body = await request.json();\n  await saveBook(body);\n  return Response.json({ ok: true });\n}\n",
        "expected": [
          "mutation_without_visible_revalidation_contract",
          "route_input_without_visible_validation_contract"
        ],
        "next": true
      },
      {
        "file": "data_surface.tsx",
        "content": "\nimport { useMutation, useQuery } from '@tanstack/react-query';\nexport function DataSurface({ id }) {\n  useQuery({ queryKey: ['book', id], queryFn: () => fetch('/api/books/' + id).then(r => r.json()) });\n  const mutation = useMutation({ mutationFn: (title) => fetch('/api/books/' + id, { method: 'PATCH', body: title }) });\n  return <button onClick={() => mutation.mutate('x')}>Save</button>;\n}\n",
        "expected": [
          "tanstack_query_cache_contract_risk"
        ]
      },
      {
        "file": "apollo_surface.tsx",
        "content": "\nimport { gql, useMutation, useQuery } from '@apollo/client';\nconst Book = gql`query Book($id: ID!) { book(id: $id) { id } }`;\nconst SaveBook = gql`mutation SaveBook($id: ID!) { saveBook(id: $id) { id } }`;\nexport function ApolloSurface({ id }) {\n  useQuery(Book, { variables: { id } });\n  const [saveBook] = useMutation(SaveBook);\n  return <button onClick={() => saveBook({ variables: { id } })}>Save</button>;\n}\n",
        "expected": [
          "apollo_query_cache_contract_risk"
        ],
        "not_expected": [
          "tanstack_query_cache_contract_risk"
        ]
      },
      {
        "file": "trpc_surface.tsx",
        "content": "\nimport { trpc } from '@acme/trpc/react';\nexport function TrpcSurface({ id }) {\n  trpc.book.byId.useQuery({ id });\n  const saveBook = trpc.book.save.useMutation();\n  return <button onClick={() => saveBook.mutate({ id })}>Save</button>;\n}\n",
        "expected": [
