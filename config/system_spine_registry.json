{
  "_meta": {
    "kind": "nexora.system_spine_registry",
    "version": "1.0.0",
    "description": "Machine-readable coordination spine for SAGE's central-but-modular nervous system. It does not replace local registries; it verifies that brain, nerve, organ, circulation and immune contracts stay connected."
  },
  "default_rules": {
    "architecture": "centralized_and_modular",
    "coordination": "one_registry_per_truth_domain_cross_checked_by_spine",
    "no_god_file": true,
    "release_rule": "spine nodes that affect release claims or agent-facing behavior must have validator and release proof participation",
    "human_authority": "machine verdicts may reach READY_FOR_HUMAN_SEAL but must not auto-create SEALED decisions"
  },
  "required_roles": [
    "brain",
    "spinal_cord",
    "circulation",
    "organ_registry",
    "immune_system",
    "agent_surface",
    "working_memory",
    "human_authority"
  ],
  "validation_contract": {
    "required_node_ids": [
      "release_proof_steps_contract",
      "release_proof_scope_contract",
      "artifact_validator_registry",
      "validator_policy_registry",
      "governance_registry",
      "capability_registry",
      "pipeline_execution_policy",
      "cli_command_contract",
      "installation_preflight_contract",
      "agent_surface_contracts",
      "actor_interaction_contract",
      "system_health_check",
      "sage_work_item_registry",
      "sage_execution_wave_registry",
      "audit_lesson_registry",
      "sage_development_loop_contract",
      "sage_active_work_package",
      "sage_self_audit_contract",
      "manual_adversarial_audit_checklist",
      "manual_adversarial_audit_progress",
      "seal_impact_policy",
      "central_decision_contracts",
      "engine_source_content_boundaries",
      "system_spine_registry",
      "system_connectivity_map",
      "product_boundary_map",
      "agent_surface_taxonomy",
      "reality_target_profiles",
      "source_role_obligation_contract"
    ]
  },
  "spine_nodes": [
    {
      "id": "release_proof_steps_contract",
      "role": "brain",
      "source": "config/release_proof_steps_contract.json",
      "validator": "tools/validate_pipeline_execution_contract.py",
      "release_proof_step": "pipeline_execution_contract",
      "raw_artifact": "output/.raw/pipeline_execution_contract_validation.json",
      "contract_guarantee": "owns release proof step ids, dependencies, raw artifacts and execution policy participation"
    },
    {
      "id": "release_proof_scope_contract",
      "role": "brain",
      "source": "config/release_proof_scope_contract.json",
