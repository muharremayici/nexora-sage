      "release_proof_step": "pipeline_execution_contract",
      "raw_artifact": "output/.raw/pipeline_execution_contract_validation.json",
      "contract_guarantee": "classifies every proof step by authority, bounds live repository scope and separates external evidence plus human authority from SAGE product proof"
    },
    {
      "id": "artifact_validator_registry",
      "role": "circulation",
      "source": "config/artifact_registry.json",
      "validator": "tools/validate_artifact_registry.py",
      "release_proof_step": "artifact_registry_validation",
      "raw_artifact": "output/.raw/artifact_registry_validation.json",
      "contract_guarantee": "owns declarative artifact schema, path, availability and storage classification; release alignment consumes the validated registry"
    },
    {
      "id": "validator_policy_registry",
      "role": "immune_system",
      "source": "config/validator_policy_registry.json",
      "validator": "tools/validate_validator_policy_registry.py",
      "release_proof_step": "validator_policy_registry_validation",
      "raw_artifact": "output/.raw/validator_policy_registry_validation.json",
      "contract_guarantee": "owns validator scan scope, explicit allowlists and triage decisions without duplicating artifact-level SQLite policy ownership"
    },
    {
      "id": "governance_registry",
      "role": "human_authority",
      "source": "config/governance_registry.json",
      "validator": "tools/validate_governance_registry.py",
      "release_proof_step": "governance_registry_validation",
      "raw_artifact": "output/.raw/governance_registry_validation.json",
      "contract_guarantee": "separates doctrine, policy, principle, cage, capability, HITL and agent-facing authority boundaries"
    },
    {
      "id": "capability_registry",
