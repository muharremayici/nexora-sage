      "level": "MUST",
      "rule": "CLI, MCP, IDE, CI, hooks and future adapters must preserve scope, authority, severity and evidence meaning."
    },
    {
      "id": "scope_expansion_is_explicit",
      "level": "MUST",
      "rule": "An actor cannot silently expand mutation scope."
    },
    {
      "id": "stale_context_cannot_authorize_mutation",
      "level": "MUST_NOT",
      "rule": "A stale package cannot authorize or validate a mutation."
    },
    {
      "id": "interface_hopping_cannot_bypass_governance",
      "level": "MUST_NOT",
      "rule": "Changing adapters cannot bypass a finding, approval or scope boundary."
    },
    {
      "id": "policy_change_is_separate_work",
      "level": "MUST",
      "rule": "Policy may change only as an explicit authorized policy task, never merely to make another task pass."
    },
    {
      "id": "actor_cannot_self_certify",
      "level": "MUST_NOT",
      "rule": "A proposing or mutating actor cannot be the sole authority declaring its result valid."
    },
    {
      "id": "unknown_is_explicit",
      "level": "MUST",
      "rule": "Missing evidence must be reported as unknown, not_available or incomplete_evidence rather than inferred away."
    }
