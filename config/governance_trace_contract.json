{
  "meta": {
    "kind": "governance_trace_contract",
    "version": "v1",
    "purpose": "Define the local, privacy-bounded trace fields used to attribute SAGE tool and governance outcomes without inferring causes from a final score."
  },
  "scope": {
    "storage": "event-owned SQLite governance_trace_events",
    "storage_authority_by_event_type": {
      "mcp_tool_call": "product-global output/.operational/mcp/mcp_call_telemetry.db",
      "nested_events_during_mcp_call": "inherit the active MCP call storage authority",
      "other_events": "active target analysis SQLite codemaps.db unless an explicit call-local authority is bound"
    },
    "local_first": true,
    "remote_egress": "prohibited_by_contract",
    "raw_content_policy": "Do not persist source code, prompts, full tool arguments, secrets, or model output. Persist only bounded metadata and deterministic fingerprints.",
    "claim_boundary": "A trace preserves observed handoffs and declared unknowns. It does not by itself prove a root cause or repository correctness."
  },
  "event": {
    "table": "governance_trace_events",
    "required_fields": [
      "trace_id",
      "recorded_at",
      "event_type",
      "principal",
      "tool_name",
      "task_fingerprint",
      "context_fingerprint",
      "policy_version",
      "state_change",
      "retry_count",
      "latency_ms",
      "outcome",
      "failure_layer",
      "claim_boundary"
    ],
    "event_types": [
      "mcp_tool_call",
      "watchdog_session",
      "release_proof_step",
      "agent_handoff",
      "work_package_operation",
      "pipeline_invocation"
    ],
    "detail_allowed_keys": {
      "mcp_tool_call": [
        "argument_keys",
        "payload_chars",
        "result_status",
        "fail_closed_reason",
        "target_mode"
      ],
      "watchdog_session": [
        "pulse_id",
        "event_batch_id",
        "analysis_status",
        "raw_event_count",
        "deduplicated_path_count",
        "metadata_only_count",
        "unknown_path_count",
        "scope_decision_status",
        "changed_file_count",
        "violation_count",
        "deep_proof_debt_status"
      ],
      "release_proof_step": [
        "step_id",
        "required",
        "timed_out",
        "timeout_basis",
        "raw_artifact_present",
        "execution_status",
        "blocked_dependency_count",
        "advisory_dependency_failure_count"
      ],
      "agent_handoff": [
        "packet_kind",
        "packet_status",
        "source_grounding_status"
      ],
      "work_package_operation": [
        "package_id",
        "package_status",
        "operation_id",
        "result_status",
        "evidence_artifact",
        "evidence_fingerprint",
        "authority"
      ],
      "pipeline_invocation": [
        "run_id",
        "lifecycle_state",
        "phase",
        "pid",
        "command_profile",
        "scope",
        "projects",
        "status_query",
        "retry_rule",
        "heartbeat_seconds",
        "duration_basis",
        "duration_sample_count",
        "duration_p50_seconds",
        "duration_p95_seconds",
        "client_timeout_floor_seconds",
        "step_id",
        "step_status",
        "active_steps",
        "execution_claim_profile",
        "execution_claim_target_step",
        "execution_claim_step_count",
        "execution_claim_boundary",
        "execution_claim_release_authority",
        "execution_claim_projects",
        "execution_claim_excluded_steps",
        "execution_claim_cost_status",
        "execution_claim_cost_basis",
        "active_run_id",
        "active_pid",
        "terminal_status",
        "exit_code",
        "interruption_reason",
        "governance_verdict",
        "elapsed_seconds",
        "completed_steps",
        "failed_steps",
        "skipped_steps",
        "evidence_identities",
        "shadow_worker_started_count",
        "shadow_worker_completed_count",
        "shadow_worker_failed_count",
        "shadow_worker_pending_count",
        "shadow_worker_global_pending_count",
        "shadow_worker_ids",
        "shadow_artifacts",
        "shadow_worker_identities_truncated",
        "shadow_flush_timed_out",
        "shadow_flush_timeout_seconds",
        "shadow_flush_wait_seconds",
        "scope_topology_authority_id",
        "scope_authority_id",
        "scope_evidence_status",
        "scope_claim",
        "scope_full_repository_claim_eligible",
        "scope_repository_inventory_file_count",
        "scope_effective_supported_source_file_count",
        "scope_indexed_source_file_count",
        "scope_claim_eligible_source_file_count",
        "scope_discovered_candidate_count",
        "scope_auto_selected_project_count",
        "scope_effective_project_count",
        "scope_excluded_project_count",
        "scope_unresolved_project_candidate_count",
        "scope_mismatch_reasons",
        "scope_consumer_checks",
        "scope_evidence_artifact"
      ]
    },
    "outcomes": [
      "success",
      "failure",
      "unknown"
    ],
    "failure_layers": [
      "none",
      "tool_visibility",
      "tool_execution",
      "validation",
      "unknown"
    ],
    "unknown_value": "not_available",
    "fingerprint_algorithm": "sha256_json_canonical_v1"
  },
  "retention": {
    "max_events_per_tenant": 1000,
    "prune_order": "oldest_recorded_at_first",
    "retention_boundary": "Operational trace retention only; never use this ledger as repository truth or a release-proof substitute."
  },
  "integration": {
    "observed_surfaces": [
      "mcp_server",
      "watchdog",
      "release_proof",
      "agent_handoff",
      "work_package_operations",
      "pipeline_orchestrator"
    ],
    "future_surfaces": [],
    "integration_rule": "A surface may emit an event only when it can preserve the contract fields or explicitly write not_available. Do not synthesize causal attribution."
  },
  "work_package_receipts": {
    "authority": "non_authoritative_evidence_proposal",
    "closure_mutation_allowed": false,
    "write_scope": "development_workspace_only",
    "clean_mirror_behavior": "skip_with_explicit_notice",
    "source_fingerprint_excluded_paths": [
      "config/sage_active_work_package.json",
      "config/sage_work_item_registry.json"
    ],
    "proposal_max_receipts": 500,
    "matching_rule": "A receipt may be proposed only when package identity and the current affected-source content fingerprint both match. A proposal never changes closure evidence, manual review, approval or human seal state.",
    "operation_profiles": {
      "sage_active_work_package_validation": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "targeted_validators_pass",
        "evidence_artifact": "output/.raw/sage_active_work_package_validation.json"
      },
      "sage_work_item_registry_validation": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "targeted_validators_pass",
        "evidence_artifact": "output/.raw/sage_work_item_registry_validation.json"
      },
      "sage_work_package_closure_validation": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "targeted_validators_pass",
        "evidence_artifact": "output/.raw/sage_work_package_closure_validation.json"
      },
      "governance_trace_contract_validation": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "targeted_validators_pass",
        "evidence_artifact": "output/.raw/governance_trace_contract_validation.json"
      },
      "actor_interaction_contract_validation": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "targeted_validators_pass",
        "evidence_artifact": "output/.raw/actor_interaction_contract_validation.json"
      },
      "source_contract_validation": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "targeted_validators_pass",
        "evidence_artifact": "output/.raw/source_contract_validation.json"
      },
      "semantic_diff_review": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "semantic_git_diff_review_completed",
        "evidence_artifact": "output/.raw/semantic_diff_impacted_lesson_projection.json"
      },
      "clean_distribution_sync": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "clean_mirror_synced_and_validated_when_applicable",
        "evidence_artifact": "not_available"
      },
      "clean_distribution_closeout": {
        "accepted_statuses": [
          "PASS"
        ],
        "closure_evidence_id": "clean_mirror_synced_and_validated_when_applicable",
        "evidence_artifact": "not_available"
      },
      "sage_learning_system_bootstrap": {
        "accepted_statuses": [
          "PASS"
        ],
        "purpose": "mutation_preflight",
        "evidence_artifact": "not_available"
      }
    },
    "evidence_requirements": {
      "targeted_validators_pass": [
        "governance_trace_contract_validation",
        "actor_interaction_contract_validation",
        "source_contract_validation",
        "sage_active_work_package_validation",
        "sage_work_item_registry_validation",
        "sage_work_package_closure_validation"
      ],
      "semantic_git_diff_review_completed": [
        "semantic_diff_review"
      ],
      "clean_mirror_synced_and_validated_when_applicable": [
        "clean_distribution_sync",
        "clean_distribution_closeout"
      ]
    },
    "closeout_policy": {
      "version": "v1",
      "changed_file_scope": {
        "classification_authority": "tools.core.source_layer_classifier.classify_source_layer",
        "excluded_source_layers": [
          "generated_runtime_artifact"
        ],
        "excluded_behavior": "report_without_affected_contract_requirement",
        "unknown_source_layers": [
          "unknown_or_review"
        ],
        "unknown_behavior": "block",
        "undeclared_governed_behavior": "block",
        "invalid_path_behavior": "block"
      },
      "evidence_applicability_by_release_mode": {
        "roadmap_delivery": {
          "required_evidence_groups": [
            "targeted_validators_pass",
            "semantic_git_diff_review_completed"
          ],
          "not_applicable_evidence_groups": {
            "clean_mirror_synced_and_validated_when_applicable": "roadmap_delivery_has_no_distribution_projection"
          }
        },
        "active_product_release": {
          "required_evidence_groups": [
            "targeted_validators_pass",
            "semantic_git_diff_review_completed",
            "clean_mirror_synced_and_validated_when_applicable"
          ],
          "not_applicable_evidence_groups": {}
        },
        "active_release_closure": {
          "required_evidence_groups": [
            "targeted_validators_pass",
            "semantic_git_diff_review_completed",
            "clean_mirror_synced_and_validated_when_applicable"
          ],
          "not_applicable_evidence_groups": {}
        }
      },
      "explicit_not_applicable_closure_status": "not_applicable",
      "unknown_release_mode_behavior": "block"
    },
    "mutation_preflight": {
      "required_operations": [
        "sage_learning_system_bootstrap"
      ],
      "accepted_package_statuses": [
        "in_progress"
      ],
      "ready_status": "READY_FOR_SAGE_OWNED_MUTATION",
      "blocked_status": "BLOCKED",
      "external_editor_enforcement": "not_available",
      "enforced_surfaces": [
        "mcp_sage_internal_mutating_tools"
      ],
      "read_only_recovery_allowed_when_blocked": true,
      "claim_boundary": "This preflight is technically enforced for SAGE_ON_SAGE mutating MCP tools and informs external developer agents. It does not gate target-repository MCP tools or physically prevent an independent editor/CLI from changing files, and it never grants closure, approval or human-seal authority."
    }
  }
}
