{
  "_meta": {
    "kind": "target_policy_profile_contract",
    "version": "v1",
    "purpose": "Central taxonomy and authority semantics for repository-declared policy discovery and runtime projection."
  },
  "authority": {
    "target_repository_threat_boundary": "config/target_repository_threat_boundary_contract.json",
    "declared": "declared_not_evaluated",
    "not_observed": "not_observed_in_configured_taxonomy",
    "profile_incomplete": "profile_incomplete_refresh_required",
    "combined_without_execution": "not_available",
    "claim_boundary": "Configuration, package and script presence proves declared policy sources only. Executable configuration and script strings are never imported or executed. This does not prove the effective per-file configuration, successful native execution or a combined governance verdict.",
    "quality_gate_projection": {
      "target_native_enforcement_statuses": [
        "declared_not_evaluated",
        "not_observed_in_configured_taxonomy",
        "profile_incomplete_refresh_required"
      ],
      "combined_verdict_statuses": [
        "not_available"
      ]
    }
  },
  "package_sections": [
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "optionalDependencies"
  ],
  "static_projection": {
    "literal_applicability": {
      "id": "bounded_literal_applicability_v1",
      "max_identity_chars": 256,
      "measurement_contract": {
        "id": "bounded_declared_loc_measurement_v1",
        "sage_basis": "inclusive_declaration_span_lines",
        "tool": "eslint",
        "rule": "max-lines-per-function",
        "reviewed_declared_versions": [
          "9.39.1"
        ],
        "false_counting_flags": [
          "skipBlankLines",
          "skipComments"
        ],
        "boundary": "Static compatibility for the source-bound direct JS-compatible callable subset only, not native execution. Matching declaration/callable line bounds, current AST identity and exact source binding are mandatory. Biome body counting, unsupported syntax/options and unresolved declared semantics retain SAGE defaults. Never reinterpret observed_loc or suppress SAGE analysis."
      },
      "loc_option_boundary": "Bounded explicit-object LOC options only. Preserve boolean counting flags without claiming measurement compatibility. Unknown keys/types, nonfinite/fractional values and values outside the declared supported range retain SAGE defaults. Zero/default/shorthand support remains unavailable, not native-invalid. ESLint's maximum is an exact JSON-number support bound, not a native schema maximum. Biome version widths are distinct from group availability. This is not complete native config validation or execution.",
      "boundary": "Conservative source-only applicability admission, not complete native config validation. Unsupported context and unknown/conflicting declared identity retain SAGE defaults. Exact declarations do not prove installed/executed identity; no URL is fetched. Biome requires an explicit supported schema or exact package declaration. Unversioned ESLint legacy literals remain shape-only evidence. Ranges/prereleases are not resolved. Global-filter/override composition and unsupported native fields require separate proof; this guard never disables SAGE native analysis.",
      "tools": {
        "eslint": {
          "requires_declared_version": false,
          "supported_declared_majors": [
            5,
            6,
            7,
            8,
            9
          ],
          "loc_options": {
            "rule_path": [
              "rules",
              "max-lines-per-function"
            ],
            "rule_id": "max-lines-per-function",
            "format": "eslint_array_object",
            "numeric_option": "max",
            "supported_minimum": 1,
            "supported_maximum": 9007199254740991,
            "boolean_options": [
              "skipBlankLines",
              "skipComments",
              "IIFEs"
            ],
            "version_maximums": []
          },
          "unsupported_root_paths": [
            "ignorePatterns",
            "processor",
            "files",
            "excludedFiles"
          ],
          "unsupported_override_paths": [
            "overrides",
            "ignorePatterns",
            "processor"
          ]
        },
        "biome": {
          "requires_declared_version": true,
          "supported_declared_majors": [
            2
          ],
          "minimum_declared_version": [
            2,
            2,
            0
          ],
          "loc_options": {
            "rule_path": [
              "linter",
              "rules",
              "complexity",
              "noExcessiveLinesPerFunction"
            ],
            "rule_id": "complexity/noExcessiveLinesPerFunction",
            "format": "biome_object_options",
            "numeric_option": "maxLines",
            "supported_minimum": 1,
            "supported_maximum": 65535,
            "boolean_options": [
              "skipBlankLines",
              "skipIifes"
            ],
            "version_maximums": [
              {
                "before": [
                  2,
                  2,
                  7
                ],
                "maximum": 255
              }
            ]
          },
          "schema_version_pattern": "https://biomejs\\.dev/schemas/([0-9]+\\.[0-9]+\\.[0-9]+)/schema\\.json",
          "unsupported_root_paths": [
            "root",
            "vcs",
            "include",
            "ignore",
            "includes",
            "ignores",
            "files.include",
            "files.ignore",
            "files.ignores",
            "files.maxSize",
            "files.experimentalScannerIgnores",
            "linter.includes",
            "linter.include",
            "linter.ignore",
            "linter.ignores",
            "javascript.linter"
          ],
          "unsupported_override_paths": [
            "overrides",
            "files",
            "include",
            "ignore",
            "ignores",
            "linter.includes",
            "linter.include",
            "linter.ignore",
            "linter.ignores",
            "javascript.linter"
          ]
        }
      }
    },
    "scope_matcher": {
      "id": "tool_specific_segment_glob_v1",
      "max_path_chars": 4096,
      "max_pattern_chars": 1024,
      "max_segments": 128,
      "max_globstars": 4,
      "boundary": "Bounded literal/*/whole-segment ** matching only, case-sensitive including dot names. Stars within a segment never cross /. ESLint legacy override basename matching is separate from Biome. Without resolved Biome version identity, admit only agreement between documented v1 implicit **/ prefix and v2 rooted semantics; disagreement is unknown. Explicit ./ anchors are supported only for ESLint legacy. Brace/class/question/extglob/negation/escape, malformed paths and over-budget forms remain unresolved, not native negatives. Earlier scope projections require refresh. No native config validity, execution or full per-file effective policy is proven."
    },
    "rule_level_contract": "tool_specific_literal_v1",
    "rule_level_boundary": "ESLint admits only numeric 0/1/2 or off/warn/error, including array-first severity, never booleans or Biome objects. Biome explicit off/info/warn/error is distinct from on (unresolved rule default). Unsupported relevant levels remain unknown rows and force LOC fallback. Earlier projections require refresh. Stylelint retains legacy inventory-only classification and has no LOC adapter. This is literal evidence, not native config validation or execution.",
    "max_rules_per_config": 500,
    "typescript_compiler_options": [
      "allowJs",
      "checkJs",
      "jsx",
      "module",
      "moduleResolution",
      "noImplicitAny",
      "strict",
      "strictNullChecks",
      "target"
    ],
    "sonar_property_allowlist": [
      "sonar.exclusions",
      "sonar.inclusions",
      "sonar.projectKey",
      "sonar.qualitygate.wait",
      "sonar.sources",
      "sonar.test.inclusions",
      "sonar.tests"
    ]
  },
  "consumer_adapters": {
    "symbol_loc_limit": {
      "authority": "declared_literal_policy_not_native_execution_proof",
      "conflict_behavior": "unresolved_fallback_to_sage_default",
      "supported_rule_mappings": [
        {
          "tool": "biome",
          "rule": "complexity/noExcessiveLinesPerFunction",
          "numeric_option": "maxLines",
          "symbol_kinds": [
            "function",
            "hook",
            "component"
          ]
        },
        {
          "tool": "eslint",
          "rule": "max-lines-per-function",
          "numeric_option": "max",
          "symbol_kinds": [
            "function",
            "hook",
            "component"
          ]
        }
      ]
    }
  },
  "tools": {
    "eslint": {
      "config_groups": [
        "eslint"
      ],
      "package_exact": [
        "eslint"
      ],
      "package_prefixes": [
        "@eslint/",
        "eslint-",
        "@typescript-eslint/"
      ],
      "command_tokens": [
        "eslint"
      ]
    },
    "biome": {
      "config_groups": [
        "biome"
      ],
      "package_exact": [
        "@biomejs/biome",
        "biome"
      ],
      "package_prefixes": [],
      "command_tokens": [
        "biome"
      ]
    },
    "prettier": {
      "config_groups": [
        "prettier"
      ],
      "package_exact": [
        "prettier"
      ],
      "package_prefixes": [
        "@prettier/",
        "prettier-plugin-"
      ],
      "command_tokens": [
        "prettier"
      ]
    },
    "typescript": {
      "config_groups": [
        "javascript_typescript"
      ],
      "package_exact": [
        "typescript"
      ],
      "package_prefixes": [],
      "command_tokens": [
        "tsc",
        "typescript"
      ]
    },
    "vitest": {
      "config_groups": [
        "vitest"
      ],
      "package_exact": [
        "vitest"
      ],
      "package_prefixes": [
        "@vitest/"
      ],
      "command_tokens": [
        "vitest"
      ]
    },
    "jest": {
      "config_groups": [
        "jest"
      ],
      "package_exact": [
        "jest",
        "ts-jest"
      ],
      "package_prefixes": [
        "@jest/"
      ],
      "command_tokens": [
        "jest"
      ]
    },
    "sonar": {
      "config_groups": [
        "sonar"
      ],
      "package_exact": [
        "sonarqube-scanner",
        "sonar-scanner"
      ],
      "package_prefixes": [
        "@sonar/"
      ],
      "command_tokens": [
        "sonar-scanner",
        "sonarqube-scanner"
      ]
    },
    "stylelint": {
      "config_groups": [
        "stylelint"
      ],
      "package_exact": [
        "stylelint"
      ],
      "package_prefixes": [
        "stylelint-",
        "@stylelint/"
      ],
      "command_tokens": [
        "stylelint"
      ]
    }
  }
}
