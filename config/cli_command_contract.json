  "agent_command_classifiers": [
    {
      "id": "sage_self_audit",
      "pattern": "(^|\\s)self-audit(\\s|$)",
      "execution_scope": "sage_self_governance_audit",
      "proof_boundary": "contract_owned_selected_release_proof_closure_not_full_release_or_human_seal",
      "agent_note": "SAGE developer/auditor self-check. It does not analyze the target repository or grant a human/public-release seal.",
      "recommended_alternative": "python sage.py release-check for the release gate; target-repository MCP tools for repository work"
    },
    {
      "id": "profile_daily",
      "pattern": "--profile\\s+daily",
      "execution_scope": "profile_daily",
      "proof_boundary": "fast_context_refresh_not_release_proof",
      "agent_note": "Daily profile is suitable for focused refresh, not final release proof.",
      "recommended_alternative": ""
    },
    {
      "id": "broad_or_release_style",
      "pattern": "(--full|--force|release-proof|release_proof)",
      "execution_scope": "broad_or_release_style",
      "proof_boundary": "broad_validation_or_release_envelope",
      "agent_note": "This is broad validation. Use it after focused edits, not as a surgical context query.",
      "recommended_alternative": ""
    },
    {
      "id": "focused_validator",
      "pattern": "(tools[\\\\/]validate_|\\s-m\\s+tools\\.)",
      "execution_scope": "focused_validator",
      "proof_boundary": "validator_specific_evidence",
      "agent_note": "Focused validator command. It proves only the named contract, not global repository freshness.",
      "recommended_alternative": ""
    },
    {
      "id": "ui_smoke_playwright",
      "pattern": "^npx(\\.cmd)?\\s+playwright\\s+test\\s+output/scripts/ui_smoke_specs/",
      "execution_scope": "ui_smoke_playwright",
      "proof_boundary": "generated_ui_smoke_spec_evidence",
      "agent_note": "Generated UI smoke spec. It proves only the listed route/candidate behavior and does not approve merge/import by itself.",
      "recommended_alternative": ""
    },
    {
      "id": "target_package_script",
      "pattern": "(^|\\s)(npm|pnpm|yarn)\\s+",
      "execution_scope": "target_package_script",
      "proof_boundary": "target_repository_script_evidence",
      "agent_note": "Target-repository package script. Run from the stated analysis root/package context.",
      "recommended_alternative": ""
    }
  ],
  "commands": [
    {
      "id": "sage_cli",
      "surface": "python sage.py <command>",
      "canonical": true,
      "intent": "product_entrypoint",
      "execution_mode": "operator_command",
      "canonical_use": "Use for public docs, clean install instructions, and human-facing workflows.",
      "not_for": [
        "legacy compatibility examples"
      ]
    },
    {
      "id": "validate_profiles",
      "surface": "python sage.py validate [--snapshot-only|--source-clean]",
      "canonical": true,
      "intent": "contract_owned_validation_profiles",
      "execution_mode": "operator_command",
      "canonical_use": "Select live refresh, existing-artifact snapshot, or source-clean validation according to the declared scope and proof boundary.",
      "not_for": [
        "release proof",
        "human seal"
      ],
      "requires_contract": "cli_command_contract.validation_execution"
    },
    {
      "id": "init_full",
      "surface": "python sage.py init --full",
      "canonical": true,
      "intent": "explicit_heavyweight_workspace_truth_build",
      "execution_mode": "release_deep",
      "canonical_use": "Prepare dependencies and workspace configuration, then force the first complete analysis after an explicit execution preflight.",
      "not_for": [
        "ordinary onboarding",
        "lightweight setup-only preparation",
        "routine edit loop"
      ],
      "requires_contract": "cli_command_contract.init_execution.modes.full"
    },
    {
      "id": "init_setup_only",
      "surface": "python sage.py init",
      "canonical": true,
      "intent": "default_workspace_setup_without_analysis",
      "execution_mode": "operator_command",
      "canonical_use": "Default onboarding path. Prepare dependencies and workspace-local discovery/configuration without running the analysis pipeline. The legacy --setup-only spelling remains accepted; run a named analysis profile afterwards when evidence is needed.",
      "not_for": [
        "analysis freshness claims",
        "release sealing"
      ],
      "requires_contract": "cli_command_contract.init_execution.modes.setup_only"
    },
    {
      "id": "init_plan_only",
      "surface": "python sage.py init --plan-only --target-root <repository>",
      "canonical": true,
      "intent": "read_only_target_aware_installation_plan",
      "execution_mode": "operator_command",
      "canonical_use": "Inspect the machine, canonical target preflight, default human-and-AI profile, and required SAGE-local dependency actions before setup. It does not install dependencies or run discovery/analysis.",
      "not_for": [
        "dependency installation",
        "repository analysis",
        "release proof"
      ],
      "requires_contract": "config/installation_preflight_contract.json"
    },
    {
      "id": "run_daily",
      "surface": "python sage.py run --profile daily",
      "canonical": true,
      "intent": "fast_development_loop",
      "execution_mode": "daily",
      "canonical_use": "Fast local development check with core truth, quality, and ContextOS surfaces.",
      "not_for": [
        "release sealing",
        "clean install proof"
      ]
    },
    {
      "id": "run_full",
      "surface": "python sage.py run --full",
      "canonical": true,
      "intent": "normal_complete_analysis",
      "execution_mode": "normal_full",
      "canonical_use": "Normal full workspace analysis that honors cache/smart profile semantics.",
      "not_for": [
        "sealed release proof",
        "forced cache rebuild"
      ]
    },
    {
      "id": "run_release_deep",
      "surface": "python sage.py run --profile release-deep",
      "canonical": true,
      "intent": "heavyweight_analysis_profile",
      "execution_mode": "release_deep",
      "canonical_use": "Run heavyweight pipeline profile when deep analysis artifacts need to be refreshed.",
      "not_for": [
        "complete proof bundle by itself"
      ]
    },
    {
      "id": "run_full_force",
      "surface": "python sage.py run --full --force",
