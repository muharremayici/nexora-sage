          "python sage.py mcp --print-config",
          "python sage.py install-proof --level release --skip-deps --target-root <repository> --projects MAIN"
        ],
        "forbidden_phrases": [
          "python sage.py release-check",
          "`python sage.py purge --mode deep`"
        ]
      }
    },
    "top_level_command_visibility": {
      "rule": "Every top-level CLI command belongs to exactly one visibility class. Public distributions expose exactly the commands in classes whose public_distribution value is true; missing and additional commands both fail closed.",
