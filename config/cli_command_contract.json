{
  "meta": {
    "kind": "cli_command_contract",
    "version": "v1",
    "description": "Canonical command intent contract for Nexora SAGE. This prevents overlapping CLI surfaces from becoming ambiguous as profiles, release gates, and proof bundles evolve."
  },
  "principles": {
    "product_entrypoint": "sage.py is the public product entrypoint. codemaps.py is an internal implementation module, not a documented user command.",
    "installation_root_vs_target_root": "The SAGE source checkout is the product installation root, not implicit authority to analyze its parent directory. Public product projections require an explicit --target-root; internal legacy layouts may retain parent-root discovery only when no public distribution manifest is present.",
    "run_vs_proof": "run commands produce or refresh analysis artifacts; release/proof commands validate and seal evidence.",
    "run_scope_semantics": "run --scope is a directory-only report filter for Scoped Host Analyzer. It does not bound Atlas generation, source snapshots, AST parsing or the rest of the pipeline.",
    "watch_path_semantics": "watch --once --path accepts one exact supported analysis source file, or an exact missing path only when the previous canonical Atlas proves that it is a deletion tombstone. A directory is a deterministic smoke sample whose acquisition compares previous indexed membership with the current filesystem, prioritizes tombstones, and discloses selected and omitted existing-file and tombstone counts. Omitted tombstones force UNKNOWN.",
    "force_vs_release_deep": "force implies release-deep profile plus cache bypass/rebuild intent; release-deep alone is a heavyweight profile, not necessarily a forced rebuild.",
    "release_check_vs_bundle": "release-check refreshes and validates the release gate envelope; run_release_proof_bundle assembles the complete proof bundle over validators and key artifacts."
  },
  "init_execution": {
    "default_mode": "setup_only",
    "duration_sample_limit": 10,
    "installation_proof_init_modes": {
      "daily": "setup_only",
      "release": "setup_only"
    },
    "modes": {
      "full": {
        "public_flag": "--full",
        "bootstrap_mode": "full",
        "analysis_profile": "release-deep",
        "force": true,
        "cost_tier": "high",
        "telemetry_identifier": "bootstrap_full_pipeline",
        "generated_scope": "workspace configuration, SQLite truth, shadow artifacts, reports, and full analysis evidence",
        "operator_guidance": "This is an explicitly requested heavyweight release-deep truth build. Ordinary onboarding defaults to setup-only, followed by a named bounded analysis profile."
      },
      "setup_only": {
        "public_flag": "",
        "bootstrap_mode": "setup",
        "analysis_profile": "none",
        "force": false,
        "cost_tier": "low",
        "telemetry_identifier": "bootstrap_setup_only",
        "required_bootstrap_calls": [
          "run_refresh",
          "generate_mcp_snippet"
        ],
        "forbidden_bootstrap_calls": [
          "run_pulse"
        ],
        "generated_scope": "dependencies when enabled, discovery, governance overrides, compiled configuration, and project-truth pruning; no analysis pipeline",
        "operator_guidance": "Default onboarding mode. Run a named bounded analysis profile after setup when repository evidence is required. Setup-only does not prove analysis freshness."
      }
    }
  },
  "validation": {
    "required_command_ids": [
      "sage_cli",
      "validate_profiles",
      "init_full",
      "init_setup_only",
      "init_plan_only",
