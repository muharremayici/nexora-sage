            "truth-sync",
            "ci-check"
          ]
        }
      },
      "public_authority_boundary": {
        "included_actor_profiles": [
          "target_repository_default",
          "target_repository_followup"
        ],
        "excluded_actor_profiles": [
          "sage_operator_debug"
        ],
        "excluded_reality_profiles": [
          "sage_self"
        ],
        "source_modification_rule": "Public license grants may allow source modification without publishing private SAGE maintainer governance, institutional memory, release proof, or seal authority.",
        "sage_source_as_target_rule": "A public user may analyze or modify the SAGE source tree through a target-repository profile; that remains SAGE_ON_REPOSITORY."
      }
    },
    "required_init_help_phrases": [
      "request the heavyweight release-deep bootstrap",
      "--full",
      "--setup-only",
      "--plan-only",
      "--target-root",
      "Run a named daily analysis after setup"
    ],
    "init_target_boundary": {
      "cli_required_tokens": [
        "full_cmd.extend([\"--target-root\", str(target_root)])",
        "PUBLIC_DISTRIBUTION_MANIFEST.is_file()",
        "this public SAGE distribution requires an explicit"
      ],
      "bootstrap_required_tokens": [
        "\"--target-root\"",
        "isolated_python_subprocess_env(",
        "this public SAGE distribution requires --target-root <repository>"
      ],
      "discovery_required_tokens": [
        "CODEMAPS_TARGET_ROOT",
        "PUBLIC_DISTRIBUTION_MANIFEST.json",
        "requires an explicit target repository",
        "\"workspace_root\": workspace_root_reference(ROOT_DIR)"
      ]
    }
  },
