      ".test.jsx",
      ".test.ts",
      ".test.js",
      ".spec.tsx",
      ".spec.jsx",
      ".spec.ts",
      ".spec.js",
      ".stories.tsx",
      ".stories.jsx",
      ".stories.ts",
      ".stories.js"
