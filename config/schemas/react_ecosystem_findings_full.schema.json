{
  "type": "object",
  "required": [
    "meta",
    "summary",
    "findings"
  ],
  "properties": {
    "meta": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "files_analyzed",
        "findings",
        "dimension_counts",
        "risk_counts",
        "risk_tiers",
        "high_risk",
        "medium_risk",
        "by_project",
        "merge_intelligence_candidates",
        "truncated_in_primary_report",
        "primary_report_finding_limit"
      ],
      "properties": {
        "files_analyzed": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        },
        "dimension_counts": {
          "type": "object"
        },
        "risk_counts": {
          "type": "object"
        },
        "risk_tiers": {
          "type": "object"
        },
        "high_risk": {
          "type": "integer"
        },
        "medium_risk": {
          "type": "integer"
        },
        "by_project": {
          "type": "object"
        },
        "merge_intelligence_candidates": {
          "type": "integer"
        },
        "truncated_in_primary_report": {
          "type": "integer"
        },
        "primary_report_finding_limit": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "file",
          "line",
          "dimension",
          "risk",
          "risk_tier",
          "score",
          "evidence",
          "recommended_action"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "dimension": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "risk_tier": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "score": {
            "type": "integer"
          },
          "evidence": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
