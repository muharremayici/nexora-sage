{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexora.private_compiler_selection_controller.v1",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schema",
        "schema_sha256",
        "schema_definition",
        "anchor_definition",
        "binding_definition",
        "result_definition",
        "default_enabled",
        "native_execution_enabled",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "model",
        "complete_status",
        "capture_profile",
        "capture_policy_sha256",
        "capture_schema_sha256",
        "selection_profile",
        "selection_policy_sha256",
        "selection_schema_sha256",
        "limits",
        "claim_boundary"
      ],
      "properties": {
        "version": {
          "const": "v1-private-selection-receipt-controller"
        },
        "schema": {
          "const": "config/schemas/compiler_selection_controller.schema.json"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_definition": {
          "const": "policy"
        },
        "anchor_definition": {
          "const": "anchor"
        },
        "binding_definition": {
          "const": "binding"
        },
        "result_definition": {
          "const": "result"
        },
        "default_enabled": {
          "type": "boolean",
          "const": false
        },
        "native_execution_enabled": {
          "type": "boolean",
          "const": false
        },
        "production_enabled": {
          "type": "boolean",
          "const": false
        },
        "semantic_lineage": {
          "type": "boolean",
          "const": false
        },
        "cache_eligible": {
          "type": "boolean",
          "const": false
        },
        "model": {
          "const": "retained_capture_anchor_and_current_request_v1"
        },
        "complete_status": {
          "const": "METADATA_LINKAGE_CHECKED_UNDER_SUPPLIED_ANCHORS_NOT_AUTHORITY_OR_FRESHNESS"
        },
        "capture_profile": {
          "const": "private_compiler_selection_capture"
        },
        "capture_policy_sha256": {
          "const": "4a40956d5be1b471d1ab64a7c931506f77fd135aeee8d603c56c3d70d3194868"
        },
        "capture_schema_sha256": {
          "const": "f49f5dbf4c0b9460f070a62c72f8bf8fc0fb3e7621dc0704ef8e91c197ab4d99"
        },
        "selection_profile": {
          "const": "private_compiler_text_selection"
        },
        "selection_policy_sha256": {
          "const": "a4d9746ced3063e058555141833e7c4f759cbfadc6c8adb1d344b2ab24df3eb2"
        },
        "selection_schema_sha256": {
          "const": "ce22113acd0c387f7d98b45e0e6fde10851af5e221a2729b4946bef2c288cdbc"
        },
        "limits": {
          "const": {
            "receipt_bytes": 16384,
            "envelope_bytes": 16384,
            "metadata_bytes": 2097152,
            "request_bytes": 32768,
            "result_bytes": 65536,
            "operation_ms": 30000
          }
        },
        "claim_boundary": {
          "const": "Default-disabled metadata linkage under caller-supplied independent expected capture anchors and a separate declared current binding. Neither anchors, permission, physical path mapping nor source freshness are authenticated. No source I/O/walk, capture/Node execution, input evaluation, runtime/production/semantic/cache/publication acceptance or measured physical heap/timing. Constructed synthetic metadata verification only."
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "anchor_ref_sha256",
        "capture_envelope_sha256",
        "selection_receipt_sha256",
        "origin_intent_sha256",
        "expected_origin_intent"
      ],
      "properties": {
        "version": {
          "const": "v1-independent-selection-capture-anchor"
        },
        "anchor_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_envelope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_intent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_origin_intent": {
          "type": "object"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "capture_root_scheme",
        "binding_ref_sha256",
        "anchor_ref_sha256",
        "capture_root_sha256",
        "capture_relative_path_sha256",
        "node_root_sha256",
        "node_entry_relative_sha256",
        "current_entry_context_sha256",
        "current_authority_sha256"
      ],
      "properties": {
        "version": {
          "const": "v1-declared-selection-operation-binding"
        },
        "capture_root_scheme": {
          "const": "preservation_absolute_path_text_utf8_v1"
        },
        "binding_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "anchor_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_root_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_relative_path_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "node_root_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "node_entry_relative_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current_entry_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current_authority_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkage_checked",
        "anchor_authenticated",
        "permission_authenticated",
        "read_authority_granted",
        "physical_path_binding_verified",
        "source_freshness_verified",
        "filesystem_capture_attested",
        "compiler_loaded",
        "input_code_evaluated",
        "node_observation_executed",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "publication_authority"
      ],
      "properties": {
        "linkage_checked": {
          "type": "boolean",
          "const": true
        },
        "anchor_authenticated": {
          "type": "boolean",
          "const": false
        },
        "permission_authenticated": {
          "type": "boolean",
          "const": false
        },
        "read_authority_granted": {
          "type": "boolean",
          "const": false
        },
        "physical_path_binding_verified": {
          "type": "boolean",
          "const": false
        },
        "source_freshness_verified": {
          "type": "boolean",
          "const": false
        },
        "filesystem_capture_attested": {
          "type": "boolean",
          "const": false
        },
        "compiler_loaded": {
          "type": "boolean",
          "const": false
        },
        "input_code_evaluated": {
          "type": "boolean",
          "const": false
        },
        "node_observation_executed": {
          "type": "boolean",
          "const": false
        },
        "production_enabled": {
          "type": "boolean",
          "const": false
        },
        "semantic_lineage": {
          "type": "boolean",
          "const": false
        },
        "cache_eligible": {
          "type": "boolean",
          "const": false
        },
        "publication_authority": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "controller_policy_sha256",
        "controller_schema_sha256",
        "anchor_ref_sha256",
        "binding_ref_sha256",
        "selection_receipt_sha256",
        "capture_envelope_sha256",
        "origin_intent_sha256",
        "content_sha256",
        "current_binding_sha256",
        "request_sha256",
        "request",
        "metadata_reserved_bytes",
        "known_metadata_reserved_bytes",
        "flags"
      ],
      "properties": {
        "version": {
          "const": "v1-private-selection-receipt-controller"
        },
        "status": {
          "const": "METADATA_LINKAGE_CHECKED_UNDER_SUPPLIED_ANCHORS_NOT_AUTHORITY_OR_FRESHNESS"
        },
        "controller_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controller_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "anchor_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_envelope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_intent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request": {
          "type": "object"
        },
        "metadata_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "known_metadata_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "flags": {
          "$ref": "#/$defs/flags"
        }
      }
    }
  }
}
