{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexora SAGE Polyglot Capability Matrix",
  "type": "object",
  "required": [
    "_meta",
    "languages",
    "claim_level_order",
    "release_guardrails"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "positioning"
      ],
      "properties": {
        "kind": {
          "const": "polyglot_capability_matrix"
        },
        "version": {
          "type": "string"
        },
        "positioning": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "languages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "claim_level",
          "supported_extensions",
          "evidence",
          "semantic_depth",
          "dead_code_reachability",
          "not_claimed"
        ],
        "properties": {
          "claim_level": {
            "enum": [
              "structural",
              "ast_strong",
              "deep_specialist"
            ]
          },
          "supported_extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\."
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "semantic_depth": {
            "type": "string",
            "minLength": 10
          },
          "dead_code_reachability": {
            "type": "object",
            "required": [
              "mode",
              "required_parser_statuses",
              "required_semantic_depths",
              "dynamic_contract_status"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "candidate_analysis",
                  "inventory_only"
                ]
              },
              "required_parser_statuses": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "required_semantic_depths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "dynamic_contract_status": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "not_claimed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "roadmap_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "claim_level_order": {
      "type": "array",
      "items": {
        "enum": [
          "structural",
          "ast_strong",
          "deep_specialist"
        ]
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "release_guardrails": {
      "type": "object",
      "required": [
        "deepest_expertise",
        "forbid_compiler_grade_claims_without_adapters",
        "required_roadmap_adapters"
      ],
      "properties": {
        "deepest_expertise": {
          "type": "string"
        },
        "forbid_compiler_grade_claims_without_adapters": {
          "type": "boolean"
        },
        "required_roadmap_adapters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "validation_contract": {
      "type": "object",
      "required": [
        "required_claim_levels",
        "required_dead_code_reachability_modes",
        "compiler_grade_forbidden_claims",
        "required_not_claimed_by_language",
        "required_roadmap_candidates_by_language",
        "human_surface_required_phrases",
        "required_roadmap_adapters"
      ],
      "properties": {
        "required_claim_levels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "structural",
              "ast_strong",
              "deep_specialist"
            ]
          }
        },
        "required_dead_code_reachability_modes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "candidate_analysis",
              "inventory_only"
            ]
          }
        },
        "compiler_grade_forbidden_claims": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required_not_claimed_by_language": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required_roadmap_candidates_by_language": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "human_surface_required_phrases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required_roadmap_adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
