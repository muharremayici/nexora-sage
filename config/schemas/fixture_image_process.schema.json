          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary",
            "root",
            "role_bytes",
            "owner_expected",
            "expected"
          ],
          "properties": {
            "boundary": {
              "type": "string",
              "pattern": "^.{1,4096}$"
            },
            "root": {
              "type": "string",
              "pattern": "^.{1,4096}$"
