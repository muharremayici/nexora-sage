                "fixture": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "stream": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "preparation": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "ingress": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
