      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stage",
        "component",
        "cleanup_settled"
      ],
      "properties": {
        "kind": {
          "const": "refused"
        },
        "stage": {
          "enum": [
            "support",
            "bootstrap",
            "policy",
            "context",
            "entry",
            "evaluation",
            "stream",
            "image"
          ]
        },
        "component": {
          "type": "string",
          "pattern": "^(?:(?:entry|fixture|text_preparation|stream_stager|image)_[a-z0-9_]{1,80}|component_refused)$"
        },
        "cleanup_settled": {
          "type": "boolean"
        }
