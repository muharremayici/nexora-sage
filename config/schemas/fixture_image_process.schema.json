          ],
          "properties": {
            "expected": {
              "type": "object"
            },
            "binding": {
              "type": "object"
            },
            "source_context": {
              "type": "object"
            },
            "admission_expected": {
              "type": "object"
            },
            "entries": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "role",
                  "bytes",
                  "raw_sha256",
                  "utf8Base64"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/[A-Za-z0-9_./-]{1,4095}$"
                  },
                  "role": {
                    "enum": [
                      "source",
                      "auxiliary"
                    ]
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "raw_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "utf8Base64": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "manifest"
          ],
          "properties": {
            "expected": {
              "type": "object"
