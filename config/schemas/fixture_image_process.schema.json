        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_context_bytes",
            "context_bytes",
            "support_schema_bytes",
            "support_raw_max",
            "frame_bytes",
            "image_metadata_upper",
            "metadata_bytes",
            "known_input_bytes",
            "output_bytes"
          ],
          "properties": {
            "input_context_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "context_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "support_schema_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "support_raw_max": {
              "type": "integer",
              "minimum": 0
            },
            "frame_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "image_metadata_upper": {
              "type": "integer",
              "minimum": 0
            },
            "metadata_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "known_input_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "role_opens": {
          "const": 5
        },
        "role_closes": {
          "const": 5
