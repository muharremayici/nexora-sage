{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexora SAGE Atlas Commit Envelope",
  "type": "object",
  "required": [
    "meta",
    "state",
    "snapshot_id",
    "generation_mode",
    "atlas_sha256",
    "source_fingerprint",
    "configuration_fingerprint",
    "generator_fingerprint",
    "projects",
    "counts"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "generated_at",
        "generator"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "nexora.atlas_commit"
          ]
        },
        "version": {
          "type": "string",
          "enum": [
            "v1"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "complete"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "generation_mode": {
      "type": "string"
    },
    "generation_transition": {
      "type": "object",
      "required": [
        "kind",
        "parent_snapshot_id",
        "changed_files",
        "changed_files_sha256"
      ],
      "properties": {
        "kind": {
          "const": "scoped_delta"
        },
        "parent_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^:]+::.+$"
          }
        },
        "changed_files_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deleted_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^:]+::.+$"
          }
        },
        "deleted_files_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "atlas_sha256": {
      "type": "string"
    },
    "source_fingerprint": {
      "type": "string"
    },
    "configuration_fingerprint": {
      "type": "string"
    },
    "generator_fingerprint": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "projects",
        "files",
        "symbols",
        "dependency_edges"
      ],
      "properties": {
        "projects": {
          "type": "integer"
        },
        "files": {
          "type": "integer"
        },
        "symbols": {
          "type": "integer"
        },
        "dependency_edges": {
          "type": "integer"
        }
      }
    }
  }
}
