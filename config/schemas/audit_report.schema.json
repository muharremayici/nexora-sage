{
  "type": "object",
  "required": [
    "meta",
    "summary",
    "audit_scope",
    "atlas_project_count",
    "audited_project_count",
    "audited_projects",
    "violation_project_count",
    "violations",
    "report_sections"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "audit_report",
            "watchdog_audit_report"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "by_rule",
        "audit_scope",
        "rule_taxonomy",
        "remediation_backlog"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "by_rule": {
          "type": "object"
        },
        "audit_scope": {
          "type": "object"
        },
        "rule_taxonomy": {
          "type": "object"
        },
        "remediation_backlog": {
          "type": "array"
        },
        "analysis_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_review_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "analysis_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "project",
              "file",
              "symbol",
              "stage",
              "error_type"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "error_type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "profile_timings": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "audit_scope": {
      "type": "object",
      "required": [
        "atlas_project_count",
        "audited_project_count",
        "audited_projects",
        "violation_project_count"
      ],
      "properties": {
        "scope_kind": {
          "type": "string",
          "enum": [
            "full_repository",
            "bounded_project_selection",
            "incomplete_evidence",
            "scoped_change"
          ]
        },
        "full_repository_claim": {
          "type": "boolean"
        },
        "atlas_project_count": {
          "type": "integer"
        },
        "audited_project_count": {
          "type": "integer"
        },
        "audited_projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violation_project_count": {
          "type": "integer"
        },
        "requested_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audited_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "audited_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_requested_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "empty"
          ]
        },
        "scope_authority": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "atlas_project_count": {
      "type": "integer"
    },
    "audited_project_count": {
      "type": "integer"
    },
    "audited_projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "violation_project_count": {
      "type": "integer"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "file",
          "rule",
          "detail",
          "recommended_action"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "finding_evidence": {
            "type": "object",
            "if": {
              "type": "object",
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "const": "v1"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/audit_import_subject"
            },
            "else": {
              "if": {
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "const": "v2"
                  }
                }
              },
              "then": {
                "$ref": "#/definitions/audit_import_restriction_subject"
              },
              "else": {
                "$ref": "#/definitions/audit_import_module_subject"
              }
            }
          },
          "symbol_name": {
            "type": "string"
          },
          "symbol_kind": {
            "type": "string"
          },
          "threshold_kind": {
            "type": "string"
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "observed_loc": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "limit_authority": {
            "type": "string",
            "minLength": 1
          },
          "target_policy_resolution": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "rule": {
                  "pattern": "^loc_limits_"
                }
              },
              "required": [
                "rule"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "symbol_name",
                "symbol_kind",
                "threshold_kind",
                "start_line",
                "end_line",
                "observed_loc",
                "limit",
                "limit_authority",
                "target_policy_resolution"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "report_sections": {
      "type": "array"
    },
    "runtime_review_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "project",
          "file",
          "target_ref",
          "guard_line",
          "sink_line",
          "source_hash",
          "evidence_source",
          "atlas_feature",
          "confidence",
          "actionability",
          "claim_boundary"
        ],
        "properties": {
          "kind": {
            "enum": [
              "immutable_key_truthiness_guard_bypass",
              "finite_number_nan_only_acceptance",
              "zod_object_broader_cast",
              "unawaited_async_helper_call",
              "caught_async_await_without_rethrow",
              "returned_queue_catch_without_rethrow",
              "queued_lookup_falsy_fallthrough",
              "repository_bulk_method_direct_storage_write",
              "failed_schema_parse_returns_raw_input",
              "repository_direct_read_return_without_local_validation",
              "repository_collection_read_return_without_local_validation",
              "shallow_copy_nested_index_write_before_await"
            ]
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "return_form": {
            "description": "Source form for repository read review candidates. A filtered_binding is bounded selection, not validation. Inline guard_line is the enclosing method declaration, not executed validation or resolved type correspondence.",
            "enum": [
              "const_binding",
              "inline_await",
              "filtered_binding"
            ]
          },
          "guard_line": {
            "type": "integer",
            "minimum": 1
          },
          "sink_line": {
            "type": "integer",
            "minimum": 2
          },
          "await_line": {
            "type": "integer",
            "minimum": 3
          },
          "source_hash": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source": {
            "const": "typescript_syntax_ast"
          },
          "atlas_feature": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "const": "needs_runtime_proof"
          },
          "actionability": {
            "const": "review"
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 1
          },
          "verification_questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "shallow_copy_nested_index_write_before_await"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "property",
                "await_line",
                "verification_questions"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "immutable_key_truthiness_guard_bypass"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "property"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "finite_number_nan_only_acceptance"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "zod_object_broader_cast"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "unawaited_async_helper_call"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "caught_async_await_without_rethrow"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "returned_queue_catch_without_rethrow",
                    "queued_lookup_falsy_fallthrough"
                  ]
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repository_bulk_method_direct_storage_write"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "failed_schema_parse_returns_raw_input"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repository_direct_read_return_without_local_validation"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions"
              ],
              "properties": {
                "return_form": {
                  "enum": [
                    "const_binding",
                    "inline_await"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repository_collection_read_return_without_local_validation"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions",
                "return_form"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "watchdog_audit_report"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "meta"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "artifact_identity"
        ],
        "properties": {
          "artifact_identity": {
            "type": "object",
            "required": [
              "status",
              "artifact_root",
              "atlas_snapshot_id",
              "target_descriptor"
            ],
            "properties": {
              "status": {
                "const": "BOUND"
              },
              "artifact_root": {
                "type": "string",
                "minLength": 1
              },
              "atlas_snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "target_descriptor": {
                "type": "object"
              }
            }
          },
          "audit_scope": {
            "type": "object",
            "required": [
              "scope_kind",
              "full_repository_claim",
              "requested_file_count",
              "requested_files",
              "audited_file_count",
              "audited_files",
              "unresolved_requested_files",
              "scope_status"
            ],
            "properties": {
              "scope_kind": {
                "const": "scoped_change"
              },
              "full_repository_claim": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "audit_import_module_subject": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "status",
        "subjects",
        "causal_relation",
        "target_native_effective_policy",
        "runtime_proof",
        "rule",
        "decision_kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/audit_import_subject/properties/kind"
        },
        "version": {
          "const": "v3"
        },
        "status": {
          "$ref": "#/definitions/audit_import_subject/properties/status"
        },
        "reason": {
          "$ref": "#/definitions/audit_import_subject/properties/reason"
        },
        "evidence_granularity": {
          "$ref": "#/definitions/audit_import_subject/properties/evidence_granularity"
        },
        "project_key": {
          "$ref": "#/definitions/audit_import_subject/properties/project_key"
        },
        "atlas_rel_path": {
          "$ref": "#/definitions/audit_import_subject/properties/atlas_rel_path"
        },
        "atlas_snapshot_id": {
          "$ref": "#/definitions/audit_import_subject/properties/atlas_snapshot_id"
        },
        "source_hash": {
          "$ref": "#/definitions/audit_import_subject/properties/source_hash"
        },
        "ast_contract_version": {
          "$ref": "#/definitions/audit_import_subject/properties/ast_contract_version"
        },
        "language": {
          "$ref": "#/definitions/audit_import_subject/properties/language"
        },
        "binding_id": {
          "$ref": "#/definitions/audit_import_subject/properties/binding_id"
        },
        "omitted_subject_count": {
          "$ref": "#/definitions/audit_import_subject/properties/omitted_subject_count"
        },
        "policy": {
          "$ref": "#/definitions/audit_import_subject/properties/policy"
        },
        "live_source_currentness": {
          "$ref": "#/definitions/audit_import_subject/properties/live_source_currentness"
        },
        "causal_relation": {
          "$ref": "#/definitions/audit_import_subject/properties/causal_relation"
        },
        "target_native_effective_policy": {
          "$ref": "#/definitions/audit_import_subject/properties/target_native_effective_policy"
        },
        "runtime_proof": {
          "$ref": "#/definitions/audit_import_subject/properties/runtime_proof"
        },
        "subjects": {
          "$ref": "#/definitions/audit_import_subject/properties/subjects"
        },
        "rule": {
          "enum": [
            "deep_imports",
            "own_api_imports"
          ]
        },
        "decision_kind": {
          "const": "module_api_import_path_decision"
        },
        "module_trace": {
          "type": "object",
          "required": [
            "module_container",
            "primary_alias",
            "module_import_prefix",
            "source_container_component_index",
            "source_module",
            "raw_prefix_offset",
            "imported_module",
            "decision_branch",
            "raw_api_terminal",
            "raw_contains_api",
            "source_api_entry_exemption",
            "api_entry_policy"
          ],
          "properties": {
            "module_container": {
              "type": "string"
            },
            "primary_alias": {
              "type": "string"
            },
            "module_import_prefix": {
              "type": "string"
            },
            "source_module": {
              "type": "string"
            },
            "imported_module": {
              "type": "string"
            },
            "source_container_component_index": {
              "type": "integer",
              "minimum": 0
            },
            "raw_prefix_offset": {
              "type": "integer",
              "minimum": 0
            },
            "decision_branch": {
              "enum": [
                "cross_module_literal_api_path",
                "same_module_literal_api_path"
              ]
            },
            "raw_api_terminal": {
              "type": "boolean"
            },
            "raw_contains_api": {
              "type": "boolean"
            },
            "source_api_entry_exemption": {},
            "api_entry_policy": {}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "bound_record_set",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "evidence_granularity",
              "project_key",
              "atlas_rel_path",
              "atlas_snapshot_id",
              "source_hash",
              "ast_contract_version",
              "language",
              "binding_id",
              "omitted_subject_count",
              "policy",
              "live_source_currentness",
              "module_trace"
            ],
            "properties": {
              "subjects": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "subjects": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "bound_record_set",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "if": {
              "type": "object",
              "required": [
                "rule"
              ],
              "properties": {
                "rule": {
                  "const": "deep_imports"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "module_trace": {
                  "type": "object",
                  "properties": {
                    "decision_branch": {
                      "const": "cross_module_literal_api_path"
                    },
                    "source_api_entry_exemption": {
                      "type": "null"
                    },
                    "api_entry_policy": {
                      "type": "null"
                    },
                    "raw_api_terminal": {
                      "type": "boolean",
                      "const": false
                    }
                  }
                }
              }
            },
            "else": {
              "type": "object",
              "properties": {
                "module_trace": {
                  "type": "object",
                  "properties": {
                    "decision_branch": {
                      "const": "same_module_literal_api_path"
                    },
                    "source_api_entry_exemption": {
                      "type": "boolean",
                      "const": false
                    },
                    "api_entry_policy": {
                      "type": "object",
                      "required": [
                        "owner",
                        "configured_entries",
                        "names",
                        "identity",
                        "pointer"
                      ],
                      "properties": {
                        "owner": {
                          "type": "string",
                          "minLength": 1
                        },
                        "configured_entries": {
                          "type": "array"
                        },
                        "names": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "identity": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "pointer": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "raw_contains_api": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "omitted_subject_count"
            ],
            "properties": {
              "omitted_subject_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "omitted_subject_count": {
                "type": "integer",
                "const": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "audit_import_restriction_subject": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "rule",
        "decision_kind",
        "status",
        "subjects",
        "causal_relation",
        "target_native_effective_policy",
        "runtime_proof"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/audit_import_subject/properties/kind"
        },
        "version": {
          "const": "v2"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "decision_kind": {
          "const": "declared_layer_import_restriction"
        },
        "status": {
          "$ref": "#/definitions/audit_import_subject/properties/status"
        },
