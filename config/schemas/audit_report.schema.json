{
  "type": "object",
  "required": [
    "meta",
    "summary",
    "audit_scope",
    "atlas_project_count",
    "audited_project_count",
    "audited_projects",
    "violation_project_count",
    "violations",
    "report_sections"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "audit_report",
            "watchdog_audit_report"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "by_rule",
        "audit_scope",
        "rule_taxonomy",
        "remediation_backlog"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "by_rule": {
          "type": "object"
        },
        "audit_scope": {
          "type": "object"
        },
        "rule_taxonomy": {
          "type": "object"
        },
        "remediation_backlog": {
          "type": "array"
        },
        "analysis_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_review_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "analysis_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "project",
              "file",
              "symbol",
              "stage",
              "error_type"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "error_type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "profile_timings": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "audit_scope": {
      "type": "object",
      "required": [
        "atlas_project_count",
        "audited_project_count",
        "audited_projects",
        "violation_project_count"
      ],
      "properties": {
        "scope_kind": {
          "type": "string",
          "enum": [
            "full_repository",
            "bounded_project_selection",
            "incomplete_evidence",
            "scoped_change"
          ]
        },
        "full_repository_claim": {
          "type": "boolean"
        },
        "atlas_project_count": {
          "type": "integer"
        },
        "audited_project_count": {
          "type": "integer"
        },
        "audited_projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violation_project_count": {
          "type": "integer"
        },
        "requested_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audited_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "audited_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_requested_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "empty"
          ]
        },
        "scope_authority": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "atlas_project_count": {
      "type": "integer"
    },
    "audited_project_count": {
      "type": "integer"
    },
    "audited_projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "violation_project_count": {
      "type": "integer"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "file",
          "rule",
          "detail",
          "recommended_action"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "symbol_name": {
            "type": "string"
          },
          "symbol_kind": {
            "type": "string"
          },
          "threshold_kind": {
            "type": "string"
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "observed_loc": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "limit_authority": {
            "type": "string",
            "minLength": 1
          },
          "target_policy_resolution": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "rule": {
                  "pattern": "^loc_limits_"
                }
              },
              "required": [
                "rule"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "symbol_name",
                "symbol_kind",
                "threshold_kind",
                "start_line",
                "end_line",
                "observed_loc",
                "limit",
                "limit_authority",
                "target_policy_resolution"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "report_sections": {
      "type": "array"
    },
    "runtime_review_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "project",
          "file",
          "target_ref",
          "guard_line",
          "sink_line",
          "source_hash",
          "evidence_source",
          "atlas_feature",
          "confidence",
          "actionability",
          "claim_boundary"
        ],
        "properties": {
          "kind": {
            "enum": [
              "immutable_key_truthiness_guard_bypass",
              "finite_number_nan_only_acceptance",
              "zod_object_broader_cast",
              "unawaited_async_helper_call",
              "caught_async_await_without_rethrow",
              "returned_queue_catch_without_rethrow",
              "queued_lookup_falsy_fallthrough",
              "repository_bulk_method_direct_storage_write",
              "failed_schema_parse_returns_raw_input",
              "repository_direct_read_return_without_local_validation",
              "repository_collection_read_return_without_local_validation"
            ]
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "return_form": {
            "description": "Source form for repository read review candidates. A filtered_binding is bounded selection, not validation. Inline guard_line is the enclosing method declaration, not executed validation or resolved type correspondence.",
            "enum": [
              "const_binding",
              "inline_await",
              "filtered_binding"
            ]
          },
          "guard_line": {
            "type": "integer",
            "minimum": 1
          },
          "sink_line": {
            "type": "integer",
            "minimum": 2
          },
          "source_hash": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source": {
            "const": "typescript_syntax_ast"
          },
          "atlas_feature": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "const": "needs_runtime_proof"
          },
          "actionability": {
            "const": "review"
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 1
          },
          "verification_questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "immutable_key_truthiness_guard_bypass"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "property"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "finite_number_nan_only_acceptance"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "zod_object_broader_cast"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "unawaited_async_helper_call"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "caught_async_await_without_rethrow"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "returned_queue_catch_without_rethrow",
                    "queued_lookup_falsy_fallthrough"
                  ]
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repository_bulk_method_direct_storage_write"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "failed_schema_parse_returns_raw_input"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions"
              ]
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repository_direct_read_return_without_local_validation"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions"
              ],
              "properties": {
                "return_form": {
                  "enum": [
                    "const_binding",
                    "inline_await"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "repository_collection_read_return_without_local_validation"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "subject",
                "verification_questions",
                "return_form"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "watchdog_audit_report"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "meta"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "artifact_identity"
        ],
        "properties": {
          "artifact_identity": {
            "type": "object",
            "required": [
              "status",
              "artifact_root",
              "atlas_snapshot_id",
              "target_descriptor"
            ],
            "properties": {
              "status": {
                "const": "BOUND"
              },
              "artifact_root": {
                "type": "string",
                "minLength": 1
              },
              "atlas_snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "target_descriptor": {
                "type": "object"
              }
            }
          },
          "audit_scope": {
            "type": "object",
            "required": [
              "scope_kind",
              "full_repository_claim",
              "requested_file_count",
              "requested_files",
              "audited_file_count",
              "audited_files",
              "unresolved_requested_files",
              "scope_status"
            ],
            "properties": {
              "scope_kind": {
                "const": "scoped_change"
              },
              "full_repository_claim": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
