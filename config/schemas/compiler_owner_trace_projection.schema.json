{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexora:compiler_owner_trace_projection",
  "title": "Disabled supplied owner-only partial trace projection",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schema",
        "default_enabled",
        "native_execution_enabled",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "model",
        "result_status",
        "failure_status",
        "trace_policy_sha256",
        "basis_policy_sha256",
        "trace_schema_sha256",
        "owner_schema_sha256",
        "trace_source_sha256",
        "owner_source_sha256",
        "limits",
        "unobserved_domains",
        "denied_flags",
        "claim_boundary",
        "source_sha256",
        "schema_sha256"
      ],
      "properties": {
        "version": {
          "const": "v1-private-partial-owner-trace-projection",
          "type": "string"
        },
        "schema": {
          "const": "config/schemas/compiler_owner_trace_projection.schema.json",
          "type": "string"
        },
        "default_enabled": {
          "const": false,
          "type": "boolean"
        },
        "native_execution_enabled": {
          "const": false,
          "type": "boolean"
        },
        "production_enabled": {
          "const": false,
          "type": "boolean"
        },
        "semantic_lineage": {
          "const": false,
          "type": "boolean"
        },
        "cache_eligible": {
          "const": false,
          "type": "boolean"
        },
        "model": {
          "const": "independently_supplied_anchor_owner_only_partial_projection_v1",
          "type": "string"
        },
        "result_status": {
          "const": "SUPPLIED_OWNER_TRACE_PARTIALLY_PROJECTED_NOT_TRANSACTION_PROOF",
          "type": "string"
        },
        "failure_status": {
          "const": "FAILED_PRODUCER_OWNER_TRACE_PARTIALLY_PROJECTED_NOT_SUCCESS",
          "type": "string"
        },
        "trace_policy_sha256": {
          "const": "a3a3511ae8dccd9b5f9f6ac8189a58457183df648e33d927a26309ae85713e23",
          "type": "string"
        },
        "basis_policy_sha256": {
          "const": "598806070d16b3212c253c2f67f0aa2ea3feb5653c95adc729320a5bdb68bddd",
          "type": "string"
        },
        "trace_schema_sha256": {
          "const": "3a2d741e286411769f106eb8a1026646c763f222a111f4d80783aea79b7058bf",
          "type": "string"
        },
        "owner_schema_sha256": {
          "const": "da0391e1c05556405e97044cb0ecc6baefc406dc4eb26650af0914ded996b693",
          "type": "string"
        },
        "trace_source_sha256": {
          "const": "671c69d36b8a517ed89169d0146cd40077dc38aea0c682aeacc3afee289d44f4",
          "type": "string"
        },
        "owner_source_sha256": {
          "const": "d66c72ac16ecfb0b74f1a5bd9d3b17c0ef3bc8e814b150a8d069f939b18c4266",
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata_bytes",
            "events",
            "output_bytes",
            "logical_component_bytes"
          ],
          "properties": {
            "metadata_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "events": {
              "type": "integer",
              "minimum": 1
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "logical_component_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "unobserved_domains": {
          "const": [
            "metadata_role_lifetimes",
            "compiled_storage",
            "declaration_and_image_lifetimes",
            "parent_transport_settlement",
            "full_work_cost",
            "physical_memory",
            "input_origin_authentication"
          ],
          "type": "array"
        },
        "denied_flags": {
          "const": [
            "actual_ownership_attested",
            "input_origin_authenticated",
            "source_freshness_verified",
            "read_authority_granted",
            "compiler_loaded",
            "input_code_evaluated",
            "complete_cost_priced",
            "physical_fit_verified",
            "replacement_factor_approved",
            "production_enabled",
            "semantic_lineage",
            "cache_eligible",
            "publication_authority"
          ],
          "type": "array"
        },
        "claim_boundary": {
          "const": "Supplied independent anchor linkage and partial owner metadata only; no input authenticity, physical/full-work bound, settled transaction, runtime or authority.",
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref_sha256",
        "expected_context_sha256",
        "outcome",
        "trace",
        "error"
      ],
      "properties": {
        "evidence_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "trace": {
          "type": "object"
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "code",
            "original_identity_retained"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "original_identity_retained": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "events",
        "recording_incomplete",
        "owner_released",
        "close_unknown",
        "role_opens",
        "role_closes",
        "owner_scope_complete",
        "transaction_settled",
        "compiler_loaded",
        "physical_fit"
      ],
      "properties": {
        "status": {
          "const": "INCOMPLETE_SYNTHETIC_OWNER_TRACE_NOT_SUCCESS",
          "type": "string"
        },
        "events": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "recording_incomplete": {
          "type": "boolean"
        },
        "owner_released": {
          "type": "boolean"
        },
        "close_unknown": {
          "type": "boolean"
        },
        "role_opens": {
          "type": "integer",
          "minimum": 0
        },
        "role_closes": {
          "type": "integer",
          "minimum": 0
        },
        "owner_scope_complete": {
          "const": false,
          "type": "boolean"
        },
        "transaction_settled": {
          "const": false,
          "type": "boolean"
        },
        "compiler_loaded": {
          "const": false,
          "type": "boolean"
        },
        "physical_fit": {
          "type": "null"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "role",
        "first",
        "second"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "transaction_begin",
            "open_attempt",
            "open_return",
            "open_unknown",
            "allocation_request",
            "backing_ready",
            "read_attempt",
            "read_return",
            "read_unknown",
            "close_attempt",
            "close_return",
            "close_unknown",
            "view_handoff",
            "text_ready",
            "owner_publish",
            "borrow_begin",
            "text_use",
            "owner_release",
            "owner_abort",
            "owner_scope_complete"
          ]
        },
        "role": {
          "enum": [
            null,
            "provenance",
            "manifest",
            "lockfile",
            "package",
            "entry"
          ]
        },
        "first": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "second": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "original_identity_retained"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "original_identity_retained": {
          "type": "boolean"
        }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "expected_context_sha256",
        "evidence_ref_sha256",
        "projection_policy_sha256",
        "projection_schema_sha256",
        "trace_policy_sha256",
        "trace_schema_sha256",
        "trace_source_sha256",
        "owner_source_sha256",
        "scope"
      ],
      "properties": {
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projection_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projection_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trace_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trace_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trace_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owner_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "const": "temporary_synthetic_entry_owner_lifetime_only",
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "producer_outcome",
        "producer_error",
        "anchors",
        "linkage_basis",
        "dimensions",
        "conditional_component_bytes",
        "component_basis",
        "relations",
        "recorded_events",
        "unpriced_event_sequences",
        "entry_read_attempts",
        "entry_read_returns",
        "known_returned_prefix_bytes",
        "role_opens",
        "role_closes",
        "complete_delivered_entry_bytes",
        "accepted_all_role_bytes",
        "metadata_reserved_bytes",
        "known_named_inputs_reserved_bytes",
        "recording_incomplete",
        "entry_close_observation",
        "aggregate_close_unknown",
        "owner_terminal_observation",
        "owner_scope_complete_event_observed",
        "producer_owner_scope_complete",
        "reported_owner_released",
        "expected_payload_size_matches_observation",
        "reservation_basis",
        "unobserved_domains",
        "full_work_units",
        "compiled_retention_bytes",
        "physical_fit",
        "transaction_settled",
        "input_origin_attested",
        "reservation_change_eligible",
        "flags"
      ],
      "properties": {
        "version": {
          "const": "v1-private-partial-owner-trace-projection",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPLIED_OWNER_TRACE_PARTIALLY_PROJECTED_NOT_TRANSACTION_PROOF",
            "FAILED_PRODUCER_OWNER_TRACE_PARTIALLY_PROJECTED_NOT_SUCCESS"
          ]
        },
        "producer_outcome": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "producer_error": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "code",
            "original_identity_retained"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "original_identity_retained": {
              "type": "boolean"
            }
          }
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_sha256",
            "expected_context_sha256",
            "evidence_ref_sha256",
            "projection_policy_sha256",
            "projection_schema_sha256",
            "trace_policy_sha256",
            "trace_schema_sha256",
            "trace_source_sha256",
            "owner_source_sha256",
            "scope"
          ],
          "properties": {
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expected_context_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidence_ref_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projection_policy_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projection_schema_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "trace_policy_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "trace_schema_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "trace_source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "owner_source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scope": {
              "const": "temporary_synthetic_entry_owner_lifetime_only",
              "type": "string"
            }
          }
        },
        "linkage_basis": {
          "const": "supplied_independent_anchors_not_authenticated",
          "type": "string"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planned_payload_bytes",
            "requested_backing_bytes",
            "ready_backing_bytes",
            "view_payload_bytes",
            "decoded_utf16_units"
          ],
          "properties": {
            "planned_payload_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "requested_backing_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "ready_backing_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "view_payload_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "decoded_utf16_units": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "conditional_component_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "component_basis": {
          "const": "ready_entry_backing_plus_two_per_decoded_utf16_unit_not_peak",
          "type": "string"
        },
        "relations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_sequence",
              "relation"
            ],
            "properties": {
              "event_sequence": {
                "type": "integer",
                "minimum": 0
              },
              "relation": {
                "enum": [
                  "view_aliases_entry_backing",
                  "same_text_borrow",
                  "same_text_use"
                ]
              }
            }
          }
        },
        "recorded_events": {
          "type": "integer",
          "minimum": 0
        },
        "unpriced_event_sequences": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "entry_read_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "entry_read_returns": {
          "type": "integer",
          "minimum": 0
        },
        "known_returned_prefix_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "role_opens": {
          "type": "integer",
          "minimum": 0
        },
        "role_closes": {
          "type": "integer",
          "minimum": 0
        },
        "complete_delivered_entry_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "accepted_all_role_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "metadata_reserved_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "known_named_inputs_reserved_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recording_incomplete": {
          "type": "boolean"
        },
        "entry_close_observation": {
          "enum": [
            "unknown",
            "returned",
            "unobserved"
          ]
        },
        "aggregate_close_unknown": {
          "type": "boolean"
        },
        "owner_terminal_observation": {
          "enum": [
            "aborted",
            "released",
            "unobserved"
          ]
        },
        "owner_scope_complete_event_observed": {
          "type": "boolean"
        },
        "producer_owner_scope_complete": {
          "type": "boolean"
        },
        "reported_owner_released": {
          "type": "boolean"
        },
        "expected_payload_size_matches_observation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reservation_basis": {
          "const": "producer_preflight_reservations_not_measured_live_peaks",
          "type": "string"
        },
        "unobserved_domains": {
          "const": [
            "metadata_role_lifetimes",
            "compiled_storage",
            "declaration_and_image_lifetimes",
            "parent_transport_settlement",
            "full_work_cost",
            "physical_memory",
            "input_origin_authentication"
          ],
          "type": "array"
        },
        "full_work_units": {
          "type": "null"
        },
        "compiled_retention_bytes": {
          "type": "null"
        },
        "physical_fit": {
          "type": "null"
        },
        "transaction_settled": {
          "const": false,
          "type": "boolean"
        },
        "input_origin_attested": {
          "const": false,
          "type": "boolean"
        },
        "reservation_change_eligible": {
          "const": false,
          "type": "boolean"
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actual_ownership_attested",
            "input_origin_authenticated",
            "source_freshness_verified",
            "read_authority_granted",
            "compiler_loaded",
            "input_code_evaluated",
            "complete_cost_priced",
            "physical_fit_verified",
            "replacement_factor_approved",
            "production_enabled",
            "semantic_lineage",
            "cache_eligible",
            "publication_authority"
          ],
          "properties": {
            "actual_ownership_attested": {
              "const": false,
              "type": "boolean"
            },
            "input_origin_authenticated": {
              "const": false,
              "type": "boolean"
            },
            "source_freshness_verified": {
              "const": false,
              "type": "boolean"
            },
            "read_authority_granted": {
              "const": false,
              "type": "boolean"
            },
            "compiler_loaded": {
              "const": false,
              "type": "boolean"
            },
            "input_code_evaluated": {
              "const": false,
              "type": "boolean"
            },
            "complete_cost_priced": {
              "const": false,
              "type": "boolean"
            },
            "physical_fit_verified": {
              "const": false,
              "type": "boolean"
            },
            "replacement_factor_approved": {
              "const": false,
              "type": "boolean"
            },
            "production_enabled": {
              "const": false,
              "type": "boolean"
            },
            "semantic_lineage": {
              "const": false,
              "type": "boolean"
            },
            "cache_eligible": {
              "const": false,
              "type": "boolean"
            },
            "publication_authority": {
              "const": false,
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
