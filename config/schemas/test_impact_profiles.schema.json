{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_impact_profiles.schema.json",
  "title": "Nexora SAGE Test Impact Profiles",
  "type": "object",
  "required": [
    "_meta",
    "languages",
    "confidence",
    "fallback_command",
    "evidence_policy"
  ],
  "properties": {
    "_meta": {
      "type": "object"
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "proof_boundary",
        "unknown_relation",
        "relation_by_match_type",
        "unexecuted_evidence",
        "mock_declaration_policy"
      ],
      "properties": {
        "proof_boundary": {
          "type": "string",
          "minLength": 1
        },
        "mock_declaration_policy": {
          "type": "object",
          "required": [
            "literal_argument_evidence_version",
            "maximum_declarations",
            "framework_imports",
            "proof_boundary"
          ],
          "properties": {
            "literal_argument_evidence_version": {
              "const": 1
            },
            "maximum_declarations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "proof_boundary": {
              "type": "string",
              "minLength": 1
            },
            "framework_imports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "imported_name",
                  "methods"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "imported_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "methods": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "unknown_relation": {
          "const": "unknown_static_relation"
        },
        "relation_by_match_type": {
          "type": "object",
          "required": [
            "Direct Static Import",
            "Direct Co-located Static Import",
            "Transitive Static Dependency",
            "Semantic Convention Match",
            "Dual Vector Match"
          ],
          "properties": {
            "Direct Static Import": {
              "const": "direct_import"
            },
            "Direct Co-located Static Import": {
              "const": "direct_import"
            },
            "Transitive Static Dependency": {
              "const": "transitive_dependency"
            },
            "Semantic Convention Match": {
              "const": "naming_only"
            },
            "Dual Vector Match": {
              "const": "unknown_static_relation"
            }
          },
          "additionalProperties": false
        },
        "unexecuted_evidence": {
          "type": "object",
          "required": [
            "confidence_semantics",
            "test_execution",
            "changed_behavior",
            "mock_binding",
            "native_diagnostics"
          ],
          "properties": {
            "confidence_semantics": {
              "const": "static_candidate_ranking_not_behavioral_coverage"
            },
            "test_execution": {
              "const": "not_run_by_sage"
            },
            "changed_behavior": {
              "const": "not_established"
            },
            "mock_binding": {
              "const": "not_assessed"
            },
            "native_diagnostics": {
              "const": "not_ingested"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ignored_path_fragments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "required": [
        "direct_static_import",
        "transitive_static_dependency",
        "semantic_convention_match",
        "dual_vector_match"
      ],
      "properties": {
        "direct_static_import": {
          "type": "number"
        },
        "transitive_static_dependency": {
          "type": "number"
        },
        "semantic_convention_match": {
          "type": "number"
        },
        "dual_vector_match": {
          "type": "number"
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "extensions",
          "command"
        ],
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_fragments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filename_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filename_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filename_suffixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "base_cleanup": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pattern",
                "replacement"
              ],
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "replacement": {
                  "type": "string"
                }
              }
            }
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "fallback_command": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
