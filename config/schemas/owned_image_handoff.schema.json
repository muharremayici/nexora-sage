{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "default_enabled",
    "production_enabled",
    "semantic_lineage",
    "max_source_files",
    "bridge_profile",
    "image_profile",
    "parser_virtual_path",
    "compiler_virtual_path",
    "atlas_relative_path",
    "input_observation_version",
    "input_observation_schema",
    "input_observation_authority",
    "claim_boundary"
  ],
  "properties": {
    "version": {
      "const": "v1-private-joined-same-text"
    },
    "schema": {
      "const": "config/schemas/owned_image_handoff.schema.json"
    },
    "default_enabled": {
      "type": "boolean",
      "const": false
    },
    "production_enabled": {
      "type": "boolean",
      "const": false
    },
    "semantic_lineage": {
      "type": "boolean",
      "const": false
    },
    "max_source_files": {
      "type": "integer",
      "const": 1
    },
    "bridge_profile": {
      "const": "private_owned_text_bridge"
    },
    "image_profile": {
      "const": "private_input_image_experiment"
    },
    "parser_virtual_path": {
      "const": "/__sage_owned_text__/entry.ts"
    },
    "compiler_virtual_path": {
      "const": "/__sage_ts_image__/project/entry.ts"
    },
    "atlas_relative_path": {
      "const": "entry.ts"
    },
    "input_observation_version": {
      "const": "v1-private-compiler-input-summary"
    },
    "input_observation_schema": {
      "const": "config/schemas/compiler_input_observation.schema.json"
    },
    "input_observation_authority": {
      "const": "producer_observed_only"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
