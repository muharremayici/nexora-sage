        "view_bytes_hashed": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_buffer_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_text_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cursor_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mapping_cursor_metadata_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "known_inputs_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_capture_attested",
        "read_authority_granted",
        "source_freshness_verified",
        "same_read_attested",
        "origin_authenticated",
        "selection_decision_authenticated",
        "controller_request_admitted",
        "table_membership_verified",
        "binding_resolved",
        "actual_export_set_complete",
        "input_code_evaluated",
        "compiler_loaded",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "publication_authority"
