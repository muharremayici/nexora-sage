      "properties": {
        "version": {
          "const": "v1-private-supplied-exact-span-selection"
        },
        "status": {
          "const": "EXACT_SPAN_CONTENT_SELECTION_RECORDED_NOT_FILE_ATTESTATION"
        },
        "purpose": {
          "const": "record_supplied_exact_span"
        },
        "producer_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_ref_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
