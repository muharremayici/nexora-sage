        "source_utf16_units": {
          "type": "integer",
          "minimum": 0
        },
        "source_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "start_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "view_utf16_units": {
          "type": "integer",
          "minimum": 0
        },
        "view_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "const": "reviewed_exact_utf16_span_v1"
        },
        "boundary_policy": {
          "const": "codepoint_and_crlf_atomic_v1"
        },
        "span_scheme": {
          "const": "supplied_text_local_utf16_utf8_half_open_v1"
        }
      }
    },
