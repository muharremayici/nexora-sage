        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "record_supplied_exact_span"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text_utf8_sha256",
        "view_text_sha256",
