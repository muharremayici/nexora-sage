{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "meta",
    "summary",
    "events"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "physical_ssot"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "status_reason",
        "unique_events",
        "occurrences_by_category"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "ATTENTION",
            "UNKNOWN"
          ]
        },
        "status_reason": {
          "type": "string"
        },
        "unique_events": {
          "type": "integer"
        },
        "occurrences_by_category": {
          "type": "object"
        },
        "occurrences_by_origin": {
          "type": "object"
        },
        "oldest_event_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_event_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "timestamp",
          "component",
          "category",
          "operation",
          "severity",
          "reason",
          "claim_impact",
          "count"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "first_seen_at": {
            "type": "string"
          },
          "last_seen_at": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "claim_impact": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    }
  }
}
