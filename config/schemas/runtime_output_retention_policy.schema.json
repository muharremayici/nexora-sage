{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_output_retention_policy.schema.json",
  "type": "object",
  "required": [
    "_meta",
    "default_policy",
    "retention_targets"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "nexora.runtime_output_retention_policy"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "default_policy": {
      "type": "object"
    },
    "retention_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "kind",
          "implemented_by",
          "claim_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "implemented_by": {
            "type": "string",
            "minLength": 1
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "backup_count": {
            "type": "integer",
            "minimum": 1
          },
          "max_events": {
            "type": "integer",
            "minimum": 1
          },
          "validator": {
            "type": "string"
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
