                "counters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entered",
                    "admitted",
                    "denied",
                    "reserved_payload",
                    "buffer_requests",
                    "buffer_returns",
                    "buffer_unknown",
                    "compare_requests",
                    "compare_returns",
                    "compare_unknown"
                  ],
                  "properties": {
                    "entered": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "admitted": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "denied": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reserved_payload": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "buffer_requests": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "buffer_returns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "buffer_unknown": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "compare_requests": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "compare_returns": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "compare_unknown": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "roots": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entered",
                    "returned",
                    "threw"
                  ],
                  "properties": {
                    "entered": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "returned": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "threw": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "terminal_before_gap": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "final_bookkeeping_complete": {
              "type": "boolean"
            },
            "references_cleared": {
              "type": "boolean"
            },
            "private_synthetic_guard": {
              "const": true
            },
            "declared_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "invocation_id",
                "tree_sha256",
                "source_sha256",
                "cut"
              ],
              "properties": {
                "invocation_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "tree_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "cut": {
                  "const": "one_live_phased_copy_six_preparation_roots"
                }
              }
            },
            "input_origin_authenticated": {
              "const": false
            },
            "budget_authority_verified": {
              "const": false
            },
            "source_identity_verified": {
              "const": false
            },
            "current_owner_enforcement": {
              "const": false
            },
            "compiler_loaded": {
              "const": false
            },
            "production_enabled": {
              "const": false
            },
            "semantic_lineage": {
              "const": false
            },
            "cache_eligible": {
              "const": false
            },
            "publication_authority": {
              "const": false
            },
            "complete_cost_priced": {
              "const": false
            },
            "full_work_units": {
              "type": "null"
            },
            "physical_fit": {
              "type": "null"
            }
          }
        },
        "comparison_gap": {
          "enum": [
            null,
            "not_started",
            "lease_unavailable",
            "comparison_unavailable",
            "snapshot_unavailable",
            "cleanup_unavailable"
          ]
        },
        "primary_stage": {
          "enum": [
            null,
            "capture_transfer",
            "prefix_borrow",
            "admission",
            "root_validation",
            "settlement",
            "owner_body",
            "publication"
          ]
        },
        "primary_kind": {
          "enum": [
            null,
            "comparison",
            "capture",
            "native_or_context"
          ]
        },
        "primary_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "cleanup_state": {
          "enum": [
            "not_started",
            "settled",
            "unavailable"
          ]
        },
        "logical_reservation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "added_named_reserved_bytes",
            "terminal_forms_used",
            "terminal_forms_reserved",
            "terminal_output_bound_bytes",
            "complete_cost_priced",
            "physical_fit",
            "comparison_pair_reserved_bytes"
          ],
          "properties": {
            "added_named_reserved_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "terminal_forms_used": {
              "type": "integer",
              "minimum": 0
            },
            "terminal_forms_reserved": {
              "type": "integer",
              "minimum": 0
            },
            "terminal_output_bound_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "complete_cost_priced": {
              "const": false
            },
            "physical_fit": {
              "type": "null"
            },
            "comparison_pair_reserved_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_origin_authenticated",
            "source_freshness_verified",
            "read_authority_granted",
            "compiler_loaded",
            "input_code_evaluated",
            "complete_cost_priced",
            "physical_fit_verified",
            "reservation_change_eligible",
            "production_enabled",
            "semantic_lineage",
            "cache_eligible",
            "publication_authority"
          ],
          "properties": {
            "input_origin_authenticated": {
              "const": false
            },
            "source_freshness_verified": {
              "const": false
            },
            "read_authority_granted": {
              "const": false
            },
            "compiler_loaded": {
              "const": false
            },
            "input_code_evaluated": {
              "const": false
            },
            "complete_cost_priced": {
              "const": false
            },
            "physical_fit_verified": {
              "const": false
            },
            "reservation_change_eligible": {
              "const": false
            },
            "production_enabled": {
              "const": false
            },
            "semantic_lineage": {
              "const": false
            },
            "cache_eligible": {
              "const": false
            },
            "publication_authority": {
              "const": false
            }
          }
        },
        "full_work_units": {
          "type": "null"
        },
        "physical_fit": {
          "type": "null"
        }
      }
    }
  }
}
