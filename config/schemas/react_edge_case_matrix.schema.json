{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "react_edge_case_matrix.schema.json",
  "title": "React Edge Case Matrix",
  "type": "object",
  "required": [
    "meta",
    "coverage_policy",
    "fixture_contract",
    "edge_cases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "positioning"
      ],
      "properties": {
        "kind": {
          "const": "react_edge_case_matrix"
        },
        "version": {
          "type": "string"
        },
        "positioning": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "coverage_policy": {
      "type": "object",
      "required": [
        "p0_required_statuses",
        "p1_required_statuses",
        "required_edge_case_ids",
        "claim_boundary"
      ],
      "properties": {
        "p0_required_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "p1_required_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "required_edge_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": true
    },
    "fixture_contract": {
      "type": "object",
      "required": [
        "claim_boundary",
        "fixture_cases",
        "non_fixture_signals"
      ],
      "properties": {
        "claim_boundary": {
          "type": "string",
          "minLength": 20
        },
        "fixture_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file",
              "content",
              "expected"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 3
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "not_expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "next": {
                "type": "boolean"
              },
              "a11y": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "non_fixture_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "signal",
              "validation_path",
              "reason"
            ],
            "properties": {
              "signal": {
                "type": "string",
                "minLength": 3
              },
              "validation_path": {
                "type": "string",
                "minLength": 3
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "edge_cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "category",
          "status",
          "static_detectors",
          "runtime_evidence",
          "required_fixture_signal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": [
              "detected",
              "covered",
              "needs_runtime_proof",
              "roadmap"
            ]
          },
          "static_detectors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "runtime_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_fixture_signal": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
