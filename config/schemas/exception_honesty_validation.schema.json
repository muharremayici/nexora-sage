{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "meta",
    "summary",
    "principles",
    "top_unobserved_by_file",
    "blocking",
    "findings"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "handlers",
        "observed",
        "allowed_quiet",
        "unobserved",
        "blocking_unobserved_generic"
      ]
    },
    "principles": {
      "type": "object"
    },
    "top_unobserved_by_file": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "count"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "blocking": {
      "type": "array"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "line",
          "function",
          "status",
          "critical",
          "generic_exception"
        ]
      }
    }
  }
}
