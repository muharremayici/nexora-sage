{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexora SAGE release evidence cadence contract",
  "type": "object",
  "required": [
    "meta",
    "governance",
    "validation",
    "invariants",
    "input_contract",
    "installation_trigger_derivation",
    "evidence_identity",
    "owners",
    "evidence",
    "acceptance_cases"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "status",
        "purpose"
      ],
      "properties": {
        "kind": {
          "const": "nexora.release_evidence_cadence_contract"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "normative"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "target_release",
        "work_item_ids",
        "one_publisher_owner_id",
        "decision_authority",
        "publication_authority",
        "rule"
      ],
      "properties": {
        "target_release": {
          "type": "string",
          "minLength": 1
        },
        "work_item_ids": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "one_publisher_owner_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_authority": {
          "const": "evidence_cadence_only"
        },
        "publication_authority": {
          "const": "never_inferred"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "required_cadence_classes",
        "required_aggregate_strategies",
        "required_subjects",
        "required_work_item_ids",
        "required_independent_retest_triggers",
        "required_owner_fields",
        "required_subject_cadences",
        "independent_install_evidence_id",
        "version_only_trigger_id",
        "allowed_owner_boundaries",
        "unknown_cadence_behavior",
        "unknown_trigger_behavior",
        "unknown_owner_behavior",
        "unknown_release_phase_behavior"
      ],
      "properties": {
        "required_cadence_classes": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "required_aggregate_strategies": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "required_subjects": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "required_work_item_ids": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "required_independent_retest_triggers": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "required_owner_fields": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "required_subject_cadences": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/nonEmptyUniqueStrings"
          }
        },
        "independent_install_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "version_only_trigger_id": {
          "type": "string",
          "minLength": 1
        },
        "allowed_owner_boundaries": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "unknown_cadence_behavior": {
          "const": "block"
        },
        "unknown_trigger_behavior": {
          "const": "block"
        },
        "unknown_owner_behavior": {
          "const": "block"
        },
        "unknown_release_phase_behavior": {
          "const": "block"
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "version_identity_change_alone_requires_independent_physical_retest",
        "independent_physical_retest_requires_protected_semantic_trigger",
        "missing_required_baseline_behavior",
        "failed_stale_tampered_or_ambiguous_evidence_reuse",
        "final_candidate_aggregate_reuse",
        "machine_evidence_may_issue_human_authority",
        "cadence_decision_may_execute_publication",
        "release_version_is_not_an_evidence_identity",
        "change_invalidation_scope"
      ],
      "properties": {
        "version_identity_change_alone_requires_independent_physical_retest": {
          "const": false
        },
        "independent_physical_retest_requires_protected_semantic_trigger": {
          "const": true
        },
        "missing_required_baseline_behavior": {
          "const": "block"
        },
        "failed_stale_tampered_or_ambiguous_evidence_reuse": {
          "const": "forbidden"
        },
        "final_candidate_aggregate_reuse": {
          "const": "content_bound_current_receipts_and_exact_frozen_candidate_identity_only"
        },
        "machine_evidence_may_issue_human_authority": {
          "const": false
        },
        "cadence_decision_may_execute_publication": {
          "const": false
        },
        "release_version_is_not_an_evidence_identity": {
          "const": true
        },
        "change_invalidation_scope": {
          "const": "changed_evidence_and_semantic_descendants_only"
        }
      },
      "additionalProperties": false
    },
    "input_contract": {
      "type": "object",
      "required": [
        "required_fields",
        "release_phase_authority",
        "release_phases",
        "trigger_catalog"
      ],
      "properties": {
        "required_fields": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "release_phase_authority": {
          "type": "object",
          "required": [
            "source",
            "json_pointer",
            "mapping_mode"
          ],
          "properties": {
            "source": {
              "const": "config/sage_self_development_validation_profiles.json"
            },
            "json_pointer": {
              "const": "/input_contract/allowed_release_phases"
            },
            "mapping_mode": {
              "const": "exact_shared_vocabulary"
            }
          },
          "additionalProperties": false
        },
        "release_phases": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "trigger_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "class"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "installation_trigger_derivation": {
      "$ref": "#/definitions/installationTriggerDerivation"
    },
    "evidence_identity": {
      "type": "object",
      "required": [
        "dimensions",
        "rule"
      ],
      "properties": {
        "dimensions": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/owner"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/evidence"
      }
    },
    "acceptance_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/acceptanceCase"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "installationTriggerDerivation": {
      "type": "object",
      "required": [
        "schema",
        "authority",
        "source_role_contract",
        "root_entrypoint_role",
        "proof_steps_contract",
        "proof_steps",
        "exact_authority_paths",
        "source_layer_triggers",
        "semantic_metadata",
        "transitive_local_python_imports_for_proof_steps",
        "unknown_source_layer_behavior",
        "generated_runtime_change_behavior",
        "known_unmatched_path_behavior",
        "receipt_authority"
      ],
      "properties": {
        "schema": {
          "const": "v1_content_bound_semantic_ownership"
        },
        "authority": {
          "const": "central_source_cli_installation_and_runtime_owners"
        },
        "source_role_contract": {
          "type": "string",
          "minLength": 1
        },
        "root_entrypoint_role": {
          "const": "root_entrypoint"
        },
        "proof_steps_contract": {
          "type": "string",
          "minLength": 1
        },
        "proof_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "trigger"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "exact_authority_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "trigger"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "source_layer_triggers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_metadata": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "ignored_json_paths",
              "changed_triggers"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "ignored_json_paths": {
                "$ref": "#/definitions/nonEmptyUniqueStrings"
              },
              "changed_triggers": {
                "$ref": "#/definitions/nonEmptyUniqueStrings"
              }
            },
            "additionalProperties": false
          }
        },
        "transitive_local_python_imports_for_proof_steps": {
          "const": true
        },
        "unknown_source_layer_behavior": {
          "const": "block"
        },
        "generated_runtime_change_behavior": {
          "const": "block"
        },
        "known_unmatched_path_behavior": {
          "const": "unaffected"
        },
        "receipt_authority": {
          "const": "cadence_input_only_no_baseline_acceptance_or_publication_authority"
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": [
        "id",
        "boundary",
        "authority",
        "sources",
        "may_publish"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "may_publish": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "cadence",
        "owner_id",
        "required_phases",
        "run_triggers",
        "identity_dimensions",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "cadence": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_strategy": {
          "enum": [
            "validate_content_bound_receipts_and_execute_invalidated_or_always_fresh",
            "fresh_execution"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "required_phases": {
          "$ref": "#/definitions/stringList"
        },
        "run_triggers": {
          "$ref": "#/definitions/stringList"
        },
        "fresh_retest_triggers": {
          "$ref": "#/definitions/stringList"
        },
        "baseline_required": {
          "type": "boolean"
        },
        "identity_dimensions": {
          "$ref": "#/definitions/nonEmptyUniqueStrings"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "acceptanceCase": {
      "type": "object",
      "required": [
        "id",
        "context",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "required": [
            "release_phase",
            "triggers",
            "available_baselines"
          ],
          "properties": {
            "release_phase": {
              "type": "string",
              "minLength": 1
            },
            "triggers": {
              "$ref": "#/definitions/stringList"
            },
            "available_baselines": {
              "$ref": "#/definitions/stringList"
            }
          },
          "additionalProperties": false
        },
        "expected": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "run_fresh",
              "baseline_plus_delta",
              "not_required",
              "blocked_missing_baseline"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
