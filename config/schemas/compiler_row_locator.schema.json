{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compiler_row_locator.schema.json",
  "title": "Disabled supplied-synthetic finite row-candidate locator",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schema",
        "schema_sha256",
        "schema_definition",
        "expected_definition",
        "result_definition",
        "default_enabled",
        "native_execution_enabled",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "image_policy_sha256",
        "cursor_limit_reference_sha256",
        "model",
        "grammar",
        "input_kind",
        "text_policy",
        "span_scheme",
        "privacy",
        "limits",
        "resource_limits",
        "complete_status",
        "incomplete_status",
        "claim_boundary",
        "row_grammar_policy_sha256"
      ],
      "properties": {
        "version": {
          "const": "v1-private-supplied-row-candidate-locator"
        },
        "schema": {
          "const": "config/schemas/compiler_row_locator.schema.json"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_definition": {
          "const": "policy"
        },
        "expected_definition": {
          "const": "expected"
        },
        "result_definition": {
          "const": "result"
        },
        "default_enabled": {
          "const": false
        },
        "native_execution_enabled": {
          "const": false
        },
        "production_enabled": {
          "const": false
        },
        "semantic_lineage": {
          "const": false
        },
        "cache_eligible": {
          "const": false
        },
        "image_policy_sha256": {
          "const": "6cee9e466a22781a52b6e2803e986c2e18608e9ebb37251d75b135ae138baf47"
        },
        "cursor_limit_reference_sha256": {
          "const": "a91254f742efb810ee150c41934346299ca5d2bb6a9c34e656b1fc49eb5b3c85"
        },
        "model": {
          "const": "supplied_immutable_text_finite_row_occurrences_v1"
        },
        "grammar": {
          "const": "finite_ascii_single_arrow_occurrences_v1"
        },
        "input_kind": {
          "const": "supplied_immutable_string_v1"
        },
        "text_policy": {
          "const": "strict_utf8_preserve_bom_shebang_crlf_v1"
        },
        "span_scheme": {
          "const": "view_local_utf16_half_open_strict_utf8_slice_v1"
        },
        "privacy": {
          "const": "local_row_range_digest_only_v1"
        },
        "limits": {
          "const": {
            "row_count": 16,
            "name_utf8_bytes": 1024,
            "token_count": 1024,
            "scan_code_units": 8192,
            "work_units": 32768,
            "fact_bytes": 16384,
            "gap_bytes": 1024,
            "cursor_bytes": 4096,
            "summary_bytes": 8192
          }
        },
        "resource_limits": {
          "const": {
            "source_utf8_bytes": 32768,
            "metadata_bytes": 2097152,
            "image_bytes": 41943040,
            "operation_ms": 30000
          }
        },
        "complete_status": {
          "const": "ROW_CANDIDATE_SCAN_COMPLETED_WITHIN_FINITE_MODEL_NOT_TABLE"
        },
        "incomplete_status": {
          "const": "PARTIAL_ROW_CANDIDATE_SCAN_UNKNOWN_LEXICAL_TAIL_NOT_TABLE"
        },
        "claim_boundary": {
          "const": "Disabled original supplied-synthetic text finite row occurrence ranges/digests only. Partial lexical coverage is explicit; no file/discovery/selection authority, enclosing table/bindings/exports, input evaluation, runtime/production/semantic/cache/publication or physical heap/RSS claim."
        },
        "row_grammar_policy_sha256": {
          "const": "1895ec6acf0f99abc858d90b2dc59bf1b823c9513031367499e0094169345a9a"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "schema_sha256",
        "source_text_sha256",
        "source_utf16_units",
        "source_utf8_bytes",
        "invocation_id"
      ],
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_utf16_units": {
          "type": "integer",
          "minimum": 0
        },
        "source_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_complete_within_model",
        "candidate_count",
        "candidates",
        "certified_prefix_end_utf16",
        "certified_prefix_end_utf8",
        "examined_through_utf16",
        "examined_through_utf8",
        "unscanned_tail_code_units",
        "unknown_tail_candidate_count",
        "gap"
      ],
      "properties": {
        "scan_complete_within_model": {
          "type": "boolean"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "certified_prefix_end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "certified_prefix_end_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "examined_through_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "examined_through_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "unscanned_tail_code_units": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_tail_candidate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gap": {
          "$ref": "#/$defs/nullable_gap"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "producer_policy_sha256",
        "producer_schema_sha256",
        "expected_sha256",
        "source_text_sha256",
        "observation",
        "observation_sha256",
        "scan_code_units",
        "token_count",
        "work_units",
        "fact_bytes",
        "name_utf8_bytes",
        "gap_bytes",
        "source_utf8_bytes",
        "source_utf16_units",
        "source_identity_bytes_hashed",
        "metadata_reserved_bytes",
        "known_inputs_reserved_bytes",
        "raw_source_retained",
        "private_facts_cleared",
        "absolute_mapping",
        "flags",
        "lookahead_peak_bytes",
        "candidate_identity_bytes_hashed",
        "lookahead_metadata_reserved_bytes"
      ],
      "properties": {
        "version": {
          "const": "v1-private-supplied-row-candidate-locator"
        },
        "status": {
          "enum": [
            "ROW_CANDIDATE_SCAN_COMPLETED_WITHIN_FINITE_MODEL_NOT_TABLE",
            "PARTIAL_ROW_CANDIDATE_SCAN_UNKNOWN_LEXICAL_TAIL_NOT_TABLE"
          ]
        },
        "producer_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "observation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scan_code_units": {
          "type": "integer",
          "minimum": 0
        },
        "token_count": {
          "type": "integer",
          "minimum": 0
        },
        "work_units": {
          "type": "integer",
          "minimum": 0
        },
        "fact_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "name_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "gap_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_utf16_units": {
          "type": "integer",
          "minimum": 0
        },
        "source_identity_bytes_hashed": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "known_inputs_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_source_retained": {
          "const": false
        },
        "private_facts_cleared": {
          "const": true
        },
        "absolute_mapping": {
          "const": null
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem_capture_attested",
            "read_authority_granted",
            "source_freshness_verified",
            "table_membership_verified",
            "table_complete",
            "actual_callsite_context_verified",
            "helper_identity_resolved",
            "binding_resolved",
            "global_byte_line_mapping_verified",
            "actual_export_set_complete",
            "input_code_evaluated",
            "compiler_loaded",
            "production_enabled",
            "semantic_lineage",
            "cache_eligible",
            "publication_authority",
            "enclosing_lexical_context_verified"
          ],
          "properties": {
            "filesystem_capture_attested": {
              "const": false
            },
            "read_authority_granted": {
              "const": false
            },
            "source_freshness_verified": {
              "const": false
            },
            "table_membership_verified": {
              "const": false
            },
            "table_complete": {
              "const": false
            },
            "actual_callsite_context_verified": {
              "const": false
            },
            "helper_identity_resolved": {
              "const": false
            },
            "binding_resolved": {
              "const": false
            },
            "global_byte_line_mapping_verified": {
              "const": false
            },
            "actual_export_set_complete": {
              "const": false
            },
            "input_code_evaluated": {
              "const": false
            },
            "compiler_loaded": {
              "const": false
            },
            "production_enabled": {
              "const": false
            },
            "semantic_lineage": {
              "const": false
            },
            "cache_eligible": {
              "const": false
            },
            "publication_authority": {
              "const": false
            },
            "enclosing_lexical_context_verified": {
              "const": false
            }
          }
        },
        "lookahead_peak_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_identity_bytes_hashed": {
          "type": "integer",
          "minimum": 0
        },
        "lookahead_metadata_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utf16",
        "end_utf16",
        "start_utf8",
        "end_utf8",
        "column_utf16_0based",
        "line_1based",
        "slice_text_utf8_sha256",
        "code"
      ],
      "properties": {
        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "start_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "column_utf16_0based": {
          "type": "integer",
          "minimum": 0
        },
        "line_1based": {
          "type": "integer",
          "minimum": 1
        },
        "slice_text_utf8_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code": {
          "type": "string",
          "enum": [
            "unsupported_token",
            "unsupported_string",
            "unclosed_comment",
            "unclosed_string",
            "unsupported_line_separator"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_index",
        "start_utf16",
        "end_utf16",
        "start_utf8",
        "end_utf8",
        "line_1based",
        "column_utf16_0based",
        "view_utf16_units",
        "view_utf8_bytes",
        "view_text_sha256",
        "single_row_grammar_policy_sha256"
      ],
      "properties": {
        "occurrence_index": {
          "type": "integer",
          "minimum": 0
        },
        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "start_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "line_1based": {
          "type": "integer",
          "minimum": 1
        },
        "column_utf16_0based": {
          "type": "integer",
          "minimum": 0
        },
        "view_utf16_units": {
          "type": "integer",
          "minimum": 0
        },
        "view_utf8_bytes": {
          "type": "integer",
