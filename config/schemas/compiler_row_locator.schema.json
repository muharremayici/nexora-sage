        },
        "single_row_grammar_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "nullable_gap": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "start_utf16",
        "end_utf16",
        "start_utf8",
        "end_utf8",
        "column_utf16_0based",
        "line_1based",
        "slice_text_utf8_sha256",
        "code"
      ],
      "properties": {
        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "start_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "column_utf16_0based": {
          "type": "integer",
          "minimum": 0
        },
        "line_1based": {
          "type": "integer",
          "minimum": 1
        },
        "slice_text_utf8_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code": {
          "type": "string",
          "enum": [
            "unsupported_token",
            "unsupported_string",
            "unclosed_comment",
            "unclosed_string",
            "unsupported_line_separator"
          ]
        }
      }
    }
  }
