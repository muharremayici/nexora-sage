{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexora.private_compiler_selection_capture.v1",
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schema",
        "schema_sha256",
        "schema_definition",
        "scope_definition",
        "receipt_definition",
        "default_enabled",
        "native_execution_enabled",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "model",
        "purpose",
        "root_scheme",
        "complete_status",
        "selection_profile",
        "selection_policy_sha256",
        "selection_schema_sha256",
        "limits",
        "claim_boundary"
      ],
      "properties": {
        "version": {
          "const": "v1-private-owned-selection-capture"
        },
        "schema": {
          "const": "config/schemas/compiler_selection_capture.schema.json"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_definition": {
          "const": "policy"
        },
        "scope_definition": {
          "const": "scope"
        },
        "receipt_definition": {
          "const": "envelope"
        },
        "default_enabled": {
          "type": "boolean",
          "const": false
        },
        "native_execution_enabled": {
          "type": "boolean",
          "const": false
        },
        "production_enabled": {
          "type": "boolean",
          "const": false
        },
        "semantic_lineage": {
          "type": "boolean",
          "const": false
        },
        "cache_eligible": {
          "type": "boolean",
          "const": false
        },
        "model": {
          "const": "single_file_fixed_selection_kernel_v1"
        },
        "purpose": {
          "const": "produce_exact_file_selection_receipt"
        },
        "root_scheme": {
          "const": "preservation_absolute_path_text_utf8_v1"
        },
        "complete_status": {
          "const": "OWNED_FILE_SELECTION_CAPTURE_COMPLETED_NOT_CURRENT_FRESHNESS"
        },
        "selection_profile": {
          "const": "private_compiler_text_selection"
        },
        "selection_policy_sha256": {
          "const": "a4d9746ced3063e058555141833e7c4f759cbfadc6c8adb1d344b2ab24df3eb2"
        },
        "selection_schema_sha256": {
          "const": "ce22113acd0c387f7d98b45e0e6fde10851af5e221a2729b4946bef2c288cdbc"
        },
        "limits": {
          "const": {
            "file_bytes": 16777216,
            "chunk_bytes": 65536,
            "metadata_bytes": 2097152,
            "envelope_bytes": 16384,
            "image_bytes": 41943040,
            "operation_ms": 30000
          }
        },
        "claim_boundary": {
          "const": "Default-disabled private fixed one-file selection capture with explicit purpose/scope. Temporary synthetic verification only. Canonical metadata receipts and checked trusted-workspace file identity do not authenticate permission, hostile filesystem origin, current freshness, actual compiler compatibility, production/semantic/cache/publication or physical heap/RSS/timing. No raw output, generic callback or input evaluation."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "root_scheme",
        "read_authority_sha256",
        "principal_sha256",
        "authority_reference_sha256",
        "root_sha256",
        "relative_path_sha256",
        "capture_policy_sha256",
        "capture_schema_sha256",
        "selection_policy_sha256",
        "selection_schema_sha256",
        "source_raw_sha256",
        "source_utf8_bytes",
        "start_line",
        "end_line"
      ],
      "properties": {
        "purpose": {
          "const": "produce_exact_file_selection_receipt"
        },
        "root_scheme": {
          "const": "preservation_absolute_path_text_utf8_v1"
        },
        "read_authority_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "principal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority_reference_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "relative_path_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_utf8_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_capture_completed",
        "source_freshness_verified",
        "read_authority_granted",
        "filesystem_capture_attested",
        "production_enabled",
        "semantic_lineage",
        "cache_eligible",
        "publication_authority"
      ],
      "properties": {
        "checked_capture_completed": {
          "type": "boolean",
          "const": true
        },
        "source_freshness_verified": {
          "type": "boolean",
          "const": false
        },
        "read_authority_granted": {
          "type": "boolean",
          "const": false
        },
        "filesystem_capture_attested": {
          "type": "boolean",
          "const": false
        },
        "production_enabled": {
          "type": "boolean",
          "const": false
        },
        "semantic_lineage": {
          "type": "boolean",
          "const": false
        },
        "cache_eligible": {
          "type": "boolean",
          "const": false
        },
        "publication_authority": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "capture_policy_sha256",
        "capture_schema_sha256",
        "origin_intent_sha256",
        "selection_receipt_sha256",
        "content_sha256",
        "observed_source_sha256",
        "origin_intent",
        "observed_source_bytes",
        "capture_open_attempts",
        "capture_read_bytes",
        "cumulative_open_attempts",
        "cumulative_read_bytes",
        "metadata_reserved_bytes",
        "capture_reserved_bytes",
        "kernel_reserved_bytes",
        "known_inputs_reserved_bytes",
        "kernel_scan_work_units",
        "flags"
      ],
      "properties": {
        "version": {
          "const": "v1-private-owned-selection-capture"
        },
        "status": {
          "const": "OWNED_FILE_SELECTION_CAPTURE_COMPLETED_NOT_CURRENT_FRESHNESS"
        },
        "capture_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capture_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_intent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_intent": {
          "$ref": "#/$defs/scope"
        },
        "observed_source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "capture_open_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "capture_read_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_open_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_read_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "capture_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "kernel_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "known_inputs_reserved_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "kernel_scan_work_units": {
          "type": "integer",
          "minimum": 0
        },
        "flags": {
          "$ref": "#/$defs/flags"
        }
      }
    }
  }
}
