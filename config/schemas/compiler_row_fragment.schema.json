          "const": "policy"
        },
        "expected_definition": {
          "const": "expected"
        },
        "result_definition": {
          "const": "result"
        },
        "default_enabled": {
          "const": false
        },
        "native_execution_enabled": {
          "const": false
        },
        "production_enabled": {
          "const": false
        },
        "semantic_lineage": {
          "const": false
        },
        "cache_eligible": {
          "const": false
        },
