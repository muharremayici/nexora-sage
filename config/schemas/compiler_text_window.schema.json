    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "kind",
        "name",
        "key_kind",
        "key_span",
        "entry_span",
        "arrow_span",
        "reference"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0
