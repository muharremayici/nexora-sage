          "enum": [
            "word",
            "string"
          ]
        },
        "key_span": {
          "$ref": "#/$defs/span"
        },
        "entry_span": {
          "$ref": "#/$defs/span"
        },
        "arrow_span": {
          "$ref": "#/$defs/span"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_span",
        "helper",
        "target",
        "table",
        "window"
      ],
      "properties": {
        "site_span": {
          "$ref": "#/$defs/span"
        },
        "helper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spelling",
            "identity_resolved",
            "span"
          ],
          "properties": {
