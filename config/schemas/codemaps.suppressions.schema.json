              "array"
            ]
          },
          "candidate": {
            "type": [
              "string",
              "array"
            ]
          },
          "target_path": {
            "type": [
              "string",
              "array"
            ]
          },
          "action": {
            "type": [
              "string",
              "array"
            ]
          },
          "decision": {
            "type": [
              "string",
              "array"
            ]
          },
          "reason": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "expires_on": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
