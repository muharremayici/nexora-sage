{
  "_meta": {
    "kind": "test_impact_profiles",
    "version": "1.0",
    "description": "Polyglot test naming and command profiles for Nexora SAGE test-impact matching."
  },
  "ignored_path_fragments": [
    "node_modules/",
    ".gemini/"
  ],
  "confidence": {
    "direct_static_import": 1.0,
    "transitive_static_dependency": 0.6,
    "semantic_convention_match": 0.8,
    "dual_vector_match": 1.0
  },
  "evidence_policy": {
    "proof_boundary": "Static test candidates are recommendations, not executed proof of the changed behavior. A high ranking score does not establish coverage, absence of mocks or a passing test result. Native test stdout/stderr is not ingested here; a passing process exit does not establish diagnostic cleanliness or changed-effect proof. Inspect target-native diagnostics and source before attributing a defect.",
    "unknown_relation": "unknown_static_relation",
    "relation_by_match_type": {
      "Direct Static Import": "direct_import",
      "Direct Co-located Static Import": "direct_import",
      "Transitive Static Dependency": "transitive_dependency",
      "Semantic Convention Match": "naming_only",
      "Dual Vector Match": "unknown_static_relation"
    },
    "mock_declaration_policy": {
      "literal_argument_evidence_version": 1,
      "maximum_declarations": 3,
      "framework_imports": [
        {
          "source": "vitest",
          "imported_name": "vi",
          "methods": [
            "mock",
            "doMock"
          ]
        },
        {
          "source": "@jest/globals",
          "imported_name": "jest",
          "methods": [
            "mock",
            "doMock"
          ]
        }
      ],
      "proof_boundary": "Observed declarations are static, snapshot-bound module-root syntax only. Runtime substitution, activation order and absence of mocks remain unproved."
    },
    "unexecuted_evidence": {
      "confidence_semantics": "static_candidate_ranking_not_behavioral_coverage",
      "test_execution": "not_run_by_sage",
      "changed_behavior": "not_established",
      "mock_binding": "not_assessed",
      "native_diagnostics": "not_ingested"
    }
  },
  "languages": {
    "typescript": {
      "extensions": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ],
      "path_fragments": [
        "/__tests__/",
        "/__test__/",
        "/tests/",
        "/test/"
      ],
      "filename_contains": [
        ".test.",
        ".spec."
      ],
      "base_cleanup": [
        {
          "pattern": "(\\.test|\\.spec)$",
          "replacement": ""
        }
      ],
      "command": "pnpm test {test_path}"
    },
    "python": {
      "extensions": [
        ".py"
      ],
      "filename_prefixes": [
        "test_"
      ],
      "filename_suffixes": [
        "_test.py"
      ],
      "base_cleanup": [
        {
          "pattern": "^test_",
          "replacement": ""
        },
        {
          "pattern": "_test$",
          "replacement": ""
        }
      ],
      "command": "pytest {test_path}"
    },
    "go": {
      "extensions": [
        ".go"
      ],
      "filename_suffixes": [
        "_test.go"
      ],
      "base_cleanup": [
        {
          "pattern": "_test$",
          "replacement": ""
        }
      ],
      "command": "go test -v ./{test_dir}"
    },
    "java": {
      "extensions": [
        ".java"
      ],
      "filename_suffixes": [
        "Test.java",
        "Tests.java"
      ],
      "base_cleanup": [
        {
          "pattern": "tests?$",
          "replacement": ""
        }
      ],
      "command": "mvn test -Dtest={class_name}"
    },
    "csharp": {
      "extensions": [
        ".cs"
      ],
      "filename_suffixes": [
        "Test.cs",
        "Tests.cs"
      ],
      "base_cleanup": [
        {
          "pattern": "tests?$",
          "replacement": ""
        }
      ],
      "command": "dotnet test --filter Name={class_name}"
    }
  },
  "fallback_command": "run-test {test_path}"
}
