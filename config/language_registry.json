      "eslint.config.ts",
      "eslint.config.cts",
      "eslint.config.mts",
      ".eslintrc",
      ".eslintrc.json",
      ".eslintrc.js",
      ".eslintrc.cjs",
      ".eslintrc.yml",
      ".eslintrc.yaml"
    ],
    "biome": [
      "biome.json",
      "biome.jsonc"
    ],
    "prettier": [
      "prettier.config.js",
      "prettier.config.cjs",
      "prettier.config.mjs",
      "prettier.config.ts",
      "prettier.config.cts",
      "prettier.config.mts",
      ".prettierrc",
      ".prettierrc.json",
      ".prettierrc.json5",
      ".prettierrc.yml",
      ".prettierrc.yaml",
      ".prettierrc.toml",
      ".prettierrc.js",
      ".prettierrc.cjs",
      ".prettierrc.mjs",
      ".prettierrc.ts",
      ".prettierrc.cts",
      ".prettierrc.mts"
    ],
    "vitest": [
      "vitest.config.js",
      "vitest.config.cjs",
      "vitest.config.mjs",
      "vitest.config.ts",
      "vitest.config.cts",
      "vitest.config.mts"
    ],
    "jest": [
      "jest.config.js",
      "jest.config.cjs",
      "jest.config.mjs",
      "jest.config.ts",
      "jest.config.cts",
      "jest.config.mts",
      "jest.config.json"
    ],
    "sonar": [
      "sonar-project.properties"
    ],
    "stylelint": [
      "stylelint.config.js",
      "stylelint.config.cjs",
      "stylelint.config.mjs",
      "stylelint.config.ts",
      ".stylelintrc",
      ".stylelintrc.json",
      ".stylelintrc.js",
      ".stylelintrc.cjs",
      ".stylelintrc.yml",
      ".stylelintrc.yaml"
    ]
  },
  "manifest_file_markers": {
    "javascript_node": [
      "package.json",
