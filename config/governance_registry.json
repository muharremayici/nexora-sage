      "capability_registry": "sage_self_release_claim",
      "audit_lesson_registry": "sage_self_learning_loop",
      "sage_development_loop_contract": "sage_self_learning_loop",
      "sage_active_work_package": "sage_self_learning_loop",
      "sage_work_package_closure": "sage_self_learning_loop",
      "sage_execution_wave_registry": "sage_self_learning_loop",
