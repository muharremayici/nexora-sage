      "governance_trace_contract": "sage_self_operator_safety",
      "actor_interaction_contract": "shared_hitl_authority",
      "target_repository_proof_contract": "target_repository_governance"
    },
    "governance_like_config_discovery": {
      "description": "Detect governance/policy/registry/contract-like config files and require each candidate to have an explicit owner surface, contributor extension surface, or owner pattern family.",
      "include_root": "config",
      "include_suffixes": [
        ".json"
      ],
      "exclude_path_prefixes": [
        "config/schemas",
        "config/golden"
      ],
      "candidate_path_tokens": [
        "governance",
        "policy",
        "registry",
        "contract",
        "doctrine",
        "principle",
        "cage",
        "capability",
        "hitl",
        "seal",
        "claim",
        "audit_lesson",
        "manual_adversarial",
        "plugin_trust",
        "runtime_output_retention",
        "agent_surface",
        "agent_harness"
      ],
      "owner_patterns": [
        {
          "owner": "policy_contract_family",
          "patterns": [
            "config/*_policy.json"
          ],
          "rationale": "Policy files are governance-like and must remain covered by source contracts, release proof, or a specific capability/cage validator."
        },
        {
          "owner": "registry_contract_family",
          "patterns": [
            "config/*_registry.json"
          ],
          "rationale": "Registry files are governance-like and must remain covered by registry validators or source contracts."
        },
        {
          "owner": "contract_family",
          "patterns": [
            "config/*_contract.json"
          ],
          "rationale": "Contract files define machine-readable boundaries and must remain covered by source contracts or specific validators."
        },
        {
          "owner": "derived_layer_contract_coverage",
          "patterns": [
            "config/derived_layer_contract_coverage_triage.json"
          ],
          "rationale": "Derived-layer contract triage records reviewed supporting-evidence decisions and is owned by the coverage validator and release-proof contract."
        },
        {
          "owner": "doctrine_pack_family",
          "patterns": [
            "config/doctrines/**/*.json",
            "config/doctrines/*.json"
          ],
          "rationale": "Doctrine pack files are owned by the modular doctrine manifest and validator."
        },
        {
          "owner": "principle_pack_family",
          "patterns": [
            "config/principles/**/*.json",
            "config/principles/*.json"
          ],
          "rationale": "Principle pack files are owned by the principles manifest and validator."
        },
        {
          "owner": "plugin_manifest_family",
          "patterns": [
            "config/plugin_manifests/**/*.json",
            "config/plugin_manifests/*.json"
          ],
          "rationale": "Declarative plugin manifests are owned by the plugin manifest contract validator."
        },
        {
          "owner": "agent_surface_taxonomy_family",
          "patterns": [
            "config/agent_surface_taxonomy.json",
            "config/agent_surface_manual_review_evidence.json"
          ],
          "rationale": "Agent surface taxonomy and manual review evidence are owned by MCP/agent-surface validation and seal review."
        },
        {
          "owner": "compiled_doctrine_family",
          "patterns": [
            "config/architecture_doctrine.json",
            "config/react_universal_analysis_doctrine.json"
          ],
          "rationale": "Compiled doctrine outputs are generated/validated through modular doctrine and React universal proof gates."
        },
        {
          "owner": "bootstrap_doctrine_template_family",
          "patterns": [
            "config/auto_doctrine_templates.json"
          ],
          "rationale": "Auto doctrine templates seed blank workspaces and are owned by doctrine bootstrap and discovery/source contract validation."
        },
        {
          "owner": "engine_signal_contract_family",
          "patterns": [
            "config/engine_signal_contracts.json"
          ],
          "rationale": "Engine signal contracts are owned by engine signal validation and release proof."
        }
      ]
    }
  },
