{
  "_meta": {
    "kind": "nexora.governance_registry",
    "version": "1.0.0",
    "description": "V1 governance surface registry for doctrine, policy, principle, cage, capability, HITL, release-claim and agent-facing extension boundaries."
  },
  "default_rules": {
    "paths": "repository_relative_only",
    "claims": "no_public_claim_expansion_without_release_claim_profile_claim_guard_and_hard_hitl",
    "separation": "doctrine_binds_principles_guide_cages_detect_capabilities_scope_contextos_directs",
    "decision_authority": "engines_produce_signals_evidence_calibrates_truth_governance_decides_actions_humans_approve_risk",
    "v1_boundary": "react_typescript_static_governance_is_active; runtime_full_sast_and_equal_depth_polyglot_claims_are_out_of_scope"
  },
  "validation": {
    "required_surface_fields": [
      "id",
      "surface_kind",
      "source",
      "runtime_output",
      "validator",
      "release_proof_step",
      "binding_level",
      "claim_impact",
      "human_seal_policy",
      "seal_scope_kind"
    ],
    "required_surface_ids": [
      "doctrine_registry",
      "principle_registry",
      "capability_registry",
      "cage_registry",
      "release_claim_profiles",
      "hitl_policy",
      "seal_impact_policy",
      "audit_lesson_registry",
      "sage_development_loop_contract",
      "sage_active_work_package",
      "sage_work_package_closure",
      "sage_execution_wave_registry",
      "sage_self_audit_contract",
      "manual_adversarial_audit_checklist",
      "agent_surface_roles",
      "plugin_trust_policy",
      "contributor_extension_contract",
      "product_boundary_contract",
      "source_role_obligation_contract",
      "decision_ownership_registry",
      "runtime_output_retention_policy",
      "governance_trace_contract",
      "actor_interaction_contract",
      "external_repository_evaluation_contract",
      "target_repository_proof_contract"
    ],
    "seal_scope_kinds": [
      "target_repo_doctrine_policy",
      "target_repo_advisory_principle",
      "target_repo_cage_policy",
      "target_repo_agent_surface",
      "target_repository_governance",
      "sage_self_release_claim",
      "sage_self_learning_loop",
      "sage_self_release_review",
      "sage_self_extension_trust",
      "sage_self_operator_safety",
      "sage_product_and_license_boundary",
      "shared_hitl_authority"
    ],
    "expected_seal_scope_kind_by_surface": {
      "doctrine_registry": "target_repo_doctrine_policy",
      "principle_registry": "target_repo_advisory_principle",
      "cage_registry": "target_repo_cage_policy",
      "agent_surface_roles": "target_repo_agent_surface",
